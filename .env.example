# =============================================================================
# FORMS — three forms, three destinations. All of them POST to /api/lead, which
# decides where the submission goes (src/pages/api/lead.ts).
#
#   /contact                    → HubSpot CRM
#   School donor waitlist       → Google Sheets
#   School ambassador waitlist  → Google Sheets
# =============================================================================

# --- HubSpot (the B2B contact form) -----------------------------------------
# Portal/Hub id. Public by design — it ships in the tracking script. Find it in
# Settings → Account Setup → Account Defaults, or in your HubSpot URL.
PUBLIC_HUBSPOT_PORTAL_ID=

# GUID of the form submissions post to. Public-safe too, but only ever used
# server-side, so it gets no PUBLIC_ prefix. Find it in the form's embed code as
# `data-form-id`, or in the form editor URL.
#
# ⚠ The form MUST have captcha / bot protection DISABLED in HubSpot. With it on,
# the submissions API refuses every request with FORM_HAS_RECAPTCHA_ENABLED.
# Spam prevention for that form is hCaptcha below, verified server-side.
HUBSPOT_FORM_GUID=

# Numeric id of the subscription type behind the "receive other communications"
# consent checkbox (the form uses "One to One").
# Find it: Settings → Marketing → Email → Subscription Types → click the type;
# the id is in the URL.
#
# ⚠ The HubSpot form marks both consent checkboxes REQUIRED, but the submissions
# API does NOT enforce that — a payload with no consent returns 200 and creates a
# contact with none recorded. src/lib/leads.ts is what actually enforces it.
#
# If this is unset the form still works and still records data-processing
# consent; only the subscription opt-in is omitted. That deliberately records
# LESS consent than was given rather than more.
HUBSPOT_SUBSCRIPTION_TYPE_ID=

# --- hCaptcha (contact form only) -------------------------------------------
# Both come from your own hcaptcha.com account. The sitekey renders the widget;
# the secret is what src/lib/hcaptcha.ts checks the token against.
#
# There is no fallback sitekey: an unset PUBLIC_HCAPTCHA_SITEKEY hides the widget
# rather than rendering one nothing verifies. If HCAPTCHA_SECRET is unset,
# verification is skipped with a warning (so local dev still works).
PUBLIC_HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# --- Google Sheets (donor + ambassador waitlists) ---------------------------
# The Apps Script Web App that appends rows. Full setup is documented at the top
# of scripts/apps-script/Code.gs — it takes about five minutes.
#
# Server-only, and it matters: the /exec URL accepts an unauthenticated POST, so
# if it shipped to the browser anyone could write rows to your spreadsheet.
# SHEETS_SECRET must match the SECRET constant inside the Apps Script.
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=

# --- Web3Forms (ARCHIVED) ---------------------------------------------------
# The old destination for every form, kept wired but dormant in
# src/lib/web3forms.ts in case the team moves off HubSpot.
#
# Leave this EMPTY. Setting it re-enables email notification alongside the real
# destination; that is the whole re-activation procedure. Note it lost its
# PUBLIC_ prefix when it moved server-side — an access key has no business in
# the browser bundle.
WEB3FORMS_KEY=

# Where the portal points schools for PREVIEWS of their pages (the "Preview" row
# on Your pages). Defaults to https://staging.xtrapoint.com if unset.
PUBLIC_STAGING_ORIGIN=

# Read token for pulling school/legal content from Sanity at build + in the OG /
# PDF / preview functions. Server-side only (never shipped to the browser).
SANITY_READ_TOKEN=

# WRITE token, used only by the portal's brand editor (src/pages/api/portal-brand.ts)
# so schools can update their own logo, colors and photos. Needs Editor
# permissions on the `production` dataset — sanity.io/manage → API → Tokens.
# Server-side only, and deliberately separate from the read token above: this one
# can change content, so keep its blast radius obvious.
SANITY_WRITE_TOKEN=

# Secret that gates the draft-preview route (/preview/schools/[slug]). Server-only.
# Must MATCH SANITY_STUDIO_PREVIEW_SECRET in studio/.env and the PREVIEW_SECRET
# env var on Vercel (Production + Preview). Generate one: openssl rand -hex 16
PREVIEW_SECRET=

# Clerk — accounts for the partner Marketing Portal (/portal). Copy both from the
# Clerk dashboard's API Keys page. Only the portal and the sign-in/sign-up pages
# use these; the marketing site stays static and anonymous (see src/middleware.ts).
#
# Test keys (pk_test_ / sk_test_) are for local + staging; swap to live keys on
# production. The publishable key is safe in the browser — the secret key is not,
# so it has no PUBLIC_ prefix and must never be referenced from client code.
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Each school = one Clerk Organization. The link between the two is the org's
# publicMetadata: {"schoolSlug": "<the Sanity school slug>"}. Set it in the Clerk
# dashboard (Organizations → the org → Metadata → Public), or a member will sign
# in and land on "we haven't finished setting you up". See src/lib/portalAuth.ts.
