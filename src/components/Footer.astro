---
import { brand } from "@/config/brand";
const preview =
  import.meta.env.DEV ||
  ["preview", "staging"].includes(process.env.VERCEL_ENV ?? "");
const year = new Date().getFullYear();
---

<footer class="brand-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" aria-label={`${brand.name} home`}>
          <img
            src={brand.logo.white}
            alt={brand.name}
            width={brand.logo.width}
            height={brand.logo.height}
          />
        </a>
        <p>For the team behind the team.</p>
        <span>Everyday giving. Ongoing support.</span>
      </div>
      <nav aria-label="Explore">
        <h2>Explore</h2>
        <a href="/#how-it-works">How it works</a>
        <a href="/#community">Who it’s for</a>
        <a href="/#features">The platform</a>
        <a href="/#ambassadors">Ambassadors</a>
        {preview && (
          <a href="/about">
            About XtraPoint <small>Preview</small>
          </a>
        )}
      </nav>
      <nav aria-label="Connect">
        <h2>Let’s connect</h2>
        <a href="/contact">Get started</a>
        <a href="/portal">Partner login</a>
        <a href={`mailto:${brand.salesEmail}`}>{brand.salesEmail}</a>
        <a href="/support">Support</a>
      </nav>
      <div class="footer-location">
        <h2>Made for community.</h2>
        <p>
          900 Wilmeth Road
          <br />
          McKinney, Texas 75069
        </p>
        <a
          href="https://www.linkedin.com/company/lpt-io/"
          aria-label="LaCore Payments Technologies on LinkedIn"
        >
          Find us on LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        © {year} LaCore Payments Technologies, Inc.
        <br />
        <span>{brand.name} is a DBA of LaCore Payments Technologies.</span>
      </p>
      <nav aria-label="Legal">
        <a href="/terms">Terms</a>
        <a href="/privacy-policy">Privacy</a>
        <a href="/cookie-policy">Cookies</a>
        <a href="/refund-policy">Refunds</a>
      </nav>
    </div>
  </div>
</footer>
<style>
  .brand-footer {
    background: var(--xp-navy);
    color: white;
    font-family: var(--xp-body);
    padding-block: 68px 30px;
  }
  .footer-inner {
    width: min(100% - 112px, 1328px);
    margin: auto;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.65fr 1fr 1fr 1.1fr;
    gap: 40px;
  }
  .footer-brand img {
    width: 188px;
    height: auto;
  }
  .footer-brand > p {
    font-size: 15px;
    letter-spacing: -0.02em;
    margin-top: 24px;
  }
  .footer-brand > span {
    display: block;
    color: #94a4ba;
    font-size: 11px;
    margin-top: 9px;
  }
  .footer-top h2 {
    font-size: 11px;
    color: #91a3ba;
    font-weight: 400;
    margin-bottom: 21px;
  }
  .footer-top nav {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
  }
  .footer-top nav h2 {
    margin-bottom: 5px;
  }
  .footer-top nav a,
  .footer-location > a {
    font-size: 12px;
    color: #d8e2ee;
    line-height: 1.5;
  }
  .footer-top nav a:hover,
  .footer-location > a:hover,
  .footer-bottom a:hover {
    color: var(--xp-lime);
  }
  .footer-top nav small {
    margin-left: 5px;
    font-size: 8px;
    color: var(--xp-lime);
    border: 1px solid #87f20045;
    padding: 3px 4px;
    border-radius: 2px;
  }
  .footer-location p {
    font-size: 12px;
    line-height: 1.7;
    color: #d8e2ee;
    margin-bottom: 18px;
  }
  .footer-location > a span {
    margin-left: 8px;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    border-top: 1px solid #ffffff18;
    margin-top: 56px;
    padding-top: 27px;
    font-size: 10px;
    line-height: 1.8;
    color: #8b9db4;
  }
  .footer-bottom p > span {
    font-size: 9px;
    color: #7f91a9;
  }
  .footer-bottom nav {
    display: flex;
    gap: 24px;
  }
  .brand-footer a:focus-visible {
    outline: 3px solid var(--xp-blue);
    outline-offset: 5px;
  }
  .footer-bottom a {
    padding-block: 9px;
  }
  @media (max-width: 1100px) {
    .footer-inner {
      width: calc(100% - 64px);
    }
    .footer-top {
      gap: 25px;
      grid-template-columns: 1.5fr 1fr 1fr;
    }
    .footer-location {
      display: none;
    }
    .footer-brand img {
      width: 170px;
    }
  }
  @media (max-width: 700px) {
    .brand-footer {
      padding-block: 49px 26px;
    }
    .footer-inner {
      width: calc(100% - 40px);
    }
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 35px 25px;
    }
    .footer-brand {
      grid-column: 1/-1;
    }
    .footer-brand > p {
      margin-top: 20px;
    }
    .footer-top nav h2 {
      margin-bottom: 7px;
    }
    .footer-top nav {
      gap: 15px;
    }
    .footer-top nav a {
      font-size: 12px;
    }
    .footer-bottom {
      display: block;
      margin-top: 37px;
      padding-top: 24px;
    }
    .footer-bottom nav {
      margin-top: 16px;
      gap: 25px;
    }
    .footer-bottom p {
      font-size: 10px;
    }
  }
</style>
