---
import { toolkit as bundledToolkit } from '@/data/toolkit';
const { resource, current, publication: toolkit = bundledToolkit } = Astro.props;
const entries = toolkit.articles.filter(entry => entry.resource === resource.id);
const categories = [...new Set(entries.map(entry => entry.category))];
---
<aside class="rc-outline"><details><summary>Topics in this resource</summary><div><a class="rc-outline-title" href={resource.href}>{resource.title}</a><nav aria-label="Resource topics">{categories.map(category => <details class="rc-outline-group" open={entries.some(entry => entry.category === category && entry.id === current)}><summary>{category}</summary>{entries.filter(entry => entry.category === category).map(entry => <a href={entry.href} aria-current={entry.id === current ? 'page' : undefined}>{entry.title}</a>)}</details>)}</nav></div></details></aside>
