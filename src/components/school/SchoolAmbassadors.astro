---
// The co-branded ambassador program page body, extracted so it can be rendered
// by both the static route (schools/[school]/ambassadors.astro, published) and
// the on-demand draft preview (preview/schools/[slug]/ambassadors.astro).
// Client islands (DotField, WaitlistForm) are client:only so the on-demand SSR
// function never server-renders browser-oriented deps — see DECISIONS.md.
import Layout from "@/layouts/Layout.astro";
import SchoolHeader from "@/components/school/SchoolHeader.astro";
import SchoolPhotoBand from "@/components/school/SchoolPhotoBand.astro";
import SchoolFooter from "@/components/school/SchoolFooter.astro";
import CtaButton from "@/components/CtaButton.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import PlaybookMark from "@/components/PlaybookMark.astro";
import DotField from "@/components/islands/DotField.tsx";
import SideRays from "@/components/islands/SideRays.tsx";
import WaitlistForm from "@/components/islands/WaitlistForm.tsx";
import { schoolThemeVars, hexToRgba, type School } from "@/data/schools";
import type { SiteSettings } from "@/data/schoolsSource";
import { brand } from "@/config/brand";

export interface Props {
  school: School;
  settings: SiteSettings;
}
const { school, settings } = Astro.props;
const t = school.theme;
const themeStyle = schoolThemeVars(t);
const donorUrl = `/schools/${school.slug}`;

// ⚠ Placeholder until the online application is built (Plaid + fund approval pending).
const enrollEmail = "enrollment@xtrapoint.com";

const whatTheyDo = [
  "Share your referral link & QR codes",
  "Promote the app on social (Instagram, TikTok)",
  "Represent it at tailgates, orientation & club events",
  "Get fans excited about round-up giving",
];

const steps = [
  { n: "01", title: "Apply & onboard", body: `Submit a short application. Once ${school.fund} approves you, complete a quick online training.` },
  { n: "02", title: "Get your toolkit", body: "Your own referral link, QR codes, social templates, scripts & FAQs — everything done for you." },
  { n: "03", title: "Promote on campus", body: "Spread the word across campus, your network, and social channels." },
  { n: "04", title: "Advance through tiers", body: "As you sign up donors, climb from Bronze to Gold and unlock bigger rewards." },
];

const criteria = [
  { title: "Current students", body: `Enrolled at ${school.short} and in good standing.` },
  { title: "Reviewed & approved", body: `Applications are reviewed and approved by ${school.fund}.` },
  { title: "Flexible & low-key", body: "Go at your own pace — no quotas, no set hours. Do what you can, when you can." },
  { title: `${school.mascot} at heart`, body: "Love for the team and a knack for connecting with people." },
];

const tiers = [
  {
    name: "Bronze",
    role: "Getting started",
    perks: ["Welcome kit", "Branded apparel & swag", "Digital recognition + LinkedIn badge"],
    highlight: false,
  },
  {
    name: "Silver",
    role: "Consistent contributor",
    perks: ["Premium apparel", "Early access", "Gift cards", "Social spotlight"],
    highlight: false,
  },
  {
    name: "Gold",
    role: "Top performer & leader",
    perks: ["VIP experiences", "Networking events", "Leadership recognition", "Internship consideration"],
    highlight: true,
  },
];

const recognition = [
  { title: "Leaderboards", body: "Friendly competition across campus." },
  { title: "Ambassador of the Month", body: "Plus recurring social spotlights." },
  { title: "End-of-year recognition", body: "A banquet celebrating top ambassadors." },
  { title: "Seasonal campaigns", body: "Tied to football, basketball, orientation & giving days." },
];
---

<Layout
  title={`${school.short} Ambassador Program × ${brand.name}`}
  description={`Become a ${school.short} Ambassador: bring round-up giving to campus and earn swag, gift cards, and VIP perks. From ${brand.name}.`}
  ogImage={`/schools/${school.slug}/og.png`}
>
  <div style={`${themeStyle}--header-h:${school.headerHeightPx ?? 68}px;`}>
    <SchoolHeader
      school={school}
      nav={{ label: "For donors", href: donorUrl }}
      cta={{ label: "How to enroll", href: "#enroll" }}
    />

    <main>
      <!-- ===================== HERO ===================== -->
      <section class="relative overflow-hidden bg-ink">
        {school.photos?.action && (
          <div class="absolute inset-0 z-0" aria-hidden="true">
            <img src={school.photos.action} alt="" class="h-full w-full object-cover object-[center_20%] opacity-30" />
            <div class="absolute inset-0 bg-gradient-to-b from-ink/70 via-ink/80 to-ink"></div>
          </div>
        )}
        <!-- Side rays (accent-tinted, animated) — layered UNDER the dots. -->
        <div class="absolute inset-0 z-0" aria-hidden="true">
          <SideRays client:only="react" rayColor1={t.primary} rayColor2={t.hasSecondary ? t.secondary : t.primary} intensity={1.4} saturation={1.3} origin="top-right" />
        </div>
        <div class="absolute inset-0 z-0" aria-hidden="true">
          <DotField client:only="react" dotSpacing={26} dotRadius={2} bulgeStrength={60} glowRadius={200} gradientFrom={hexToRgba(t.primary, 0.5)} gradientTo={hexToRgba(t.secondary, 0.18)} glowColor={hexToRgba(t.primary, 0.5)} />
        </div>
        <div class="dot-grid"></div>
        <div class="glow anim-float-1" style={`width:460px;height:460px;top:-10%;left:4%;background:radial-gradient(circle,${t.secondarySoft} 0%,transparent 65%);opacity:0.9;`} aria-hidden="true"></div>
        <PlaybookMark mark="o" class="right-8 top-10 hidden h-20 w-20 lg:block" rotate={-10} opacity={0.8} delay={0.4} color="var(--color-accent-2)" />

        <div class="relative z-10 mx-auto max-w-4xl px-6 pb-20 pt-[calc(var(--header-h)+5rem)] text-center lg:px-10 lg:pb-28 lg:pt-[calc(var(--header-h)+7rem)]">
          <p class="font-mono text-xs uppercase tracking-[0.12em] text-accent-2">
            Ambassador Program · {school.short}
          </p>
          <h1 class="font-display mx-auto mt-4 max-w-[16ch] text-[clamp(3rem,7vw,5.25rem)] uppercase leading-[1.02] tracking-tight text-white">
            Lead the
            <span class="font-editorial my-1 block text-[1.1em] leading-[0.9] text-lime [text-transform:none]">movement</span>
            on campus.
          </h1>
          <div class="reveal">
            <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/75">
              Become a {school.short} Ambassador, bring round-up giving to the
              {" "}{school.mascot} fanbase, and earn rewards, recognition, and real
              leadership experience while you do it.
            </p>
            <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
              <CtaButton href="#enroll" variant="lime" glow={false}>How to enroll</CtaButton>
              <a href="#incentives" class="font-mono text-xs uppercase tracking-[0.06em] text-white/60 underline-offset-4 hover:text-white hover:underline">See what you'll earn ↓</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== WHAT IT IS ===================== -->
      <section class="relative overflow-hidden bg-white py-20 lg:py-28">
        <div class="relative z-10 mx-auto grid max-w-7xl items-center gap-12 px-6 lg:grid-cols-[1fr_1fr] lg:gap-16 lg:px-10">
          <div class="reveal-left">
            <Eyebrow index="01" label="What it is" />
            <h2 class="font-display mt-4 max-w-[18ch] text-[clamp(2.5rem,6vw,4rem)] uppercase leading-[0.92] tracking-[-0.015em] text-gray-900">
              A student-powered <span class="ed ed-dark">Team</span>.
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              The {brand.name} Ambassador Program is a crew of {school.short}
              students who bring round-up giving to campus. You spread the word,
              sign up donors, and help fund {school.short} athletics, scholarships,
              and student initiatives — building your résumé and network along the
              way.
            </p>
          </div>
          <ul class="stagger flex flex-col gap-3">
            {whatTheyDo.map((d) => (
              <li class="flex items-center gap-3.5 rounded-xl border border-gray-200 bg-white px-5 py-4">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-lime-soft text-lime-dark">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
                </span>
                <span class="font-medium text-gray-900">{d}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ===================== HOW IT WORKS ===================== -->
      <section class="relative overflow-hidden bg-gray-50 py-20 lg:py-28">
        <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-10">
          <div class="reveal max-w-3xl">
            <Eyebrow index="02" label="How it works" />
            <h2 class="font-display mt-4 text-[clamp(2.5rem,6vw,4rem)] uppercase leading-[0.92] tracking-[-0.015em] text-gray-900">
              From apply to <span class="ed ed-dark">Gold</span>.
            </h2>
          </div>
          <div class="stagger mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {steps.map((s) => (
              <div class="rounded-2xl border border-gray-200 bg-white p-7">
                <span class="font-display text-3xl leading-none text-lime-dark">{s.n}</span>
                <h3 class="mt-4 text-lg font-bold tracking-tight text-gray-900">{s.title}</h3>
                <p class="mt-2 leading-relaxed text-gray-600">{s.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================== SPIRIT BAND ===================== -->
      {school.photos?.mascot && (
        <SchoolPhotoBand src={school.photos.mascot} position="center 30%">
          <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-lime">Lead the charge</p>
          <h2 class="font-display mt-4 text-[clamp(2.5rem,6vw,4.5rem)] uppercase leading-[0.95] tracking-tight text-white">
            Be the face of the <span class="ed">movement</span>.
          </h2>
          <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/80">
            Ambassadors bring the energy that turns {school.mascot} fans into
            donors — on campus, at every tailgate, and all over social.
          </p>
        </SchoolPhotoBand>
      )}

      <!-- ===================== CRITERIA ===================== -->
      <section class="relative overflow-hidden bg-white py-20 lg:py-28">
        <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-10">
          <div class="reveal max-w-3xl">
            <Eyebrow index="03" label="Criteria to enroll" />
            <h2 class="font-display mt-4 text-[clamp(2.5rem,6vw,4rem)] uppercase leading-[0.92] tracking-[-0.015em] text-gray-900">
              Who can <span class="ed ed-dark">Join</span>.
            </h2>
          </div>
          <div class="stagger mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {criteria.map((c) => (
              <div class="rounded-2xl border border-gray-200 p-7">
                <h3 class="text-lg font-bold tracking-tight text-gray-900">{c.title}</h3>
                <p class="mt-2 leading-relaxed text-gray-600">{c.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================== INCENTIVES ===================== -->
      <section id="incentives" class="relative overflow-hidden bg-ink py-20 text-white lg:py-28">
        <div class="dot-grid"></div>
        <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-10">
          <div class="reveal max-w-3xl">
            <Eyebrow index="04" label="Incentives" dark />
            <h2 class="font-display mt-4 text-[clamp(2.5rem,6vw,4rem)] uppercase leading-[0.92] tracking-[-0.015em] text-white">
              The three-tier <span class="ed">Structure</span>.
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-white/75">
              Tiers reward you for sign-ups, active donors, and campus engagement.
              Exact thresholds are shared during onboarding.
            </p>
          </div>
          <div class="stagger mt-14 grid gap-6 lg:grid-cols-3">
            {tiers.map((tier) => (
              <div class={`flex flex-col rounded-3xl p-8 ring-1 ${tier.highlight ? "bg-lime text-on-accent ring-lime" : "bg-white/[0.04] text-white ring-white/10"}`}>
                <div class="flex items-center justify-between">
                  <span class="font-display text-2xl uppercase tracking-tight">{tier.name}</span>
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M9 12.5L7 22l5-3 5 3-2-9.5"/></svg>
                </div>
                <p class={`mt-1 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] ${tier.highlight ? "text-on-accent/70" : "text-lime"}`}>{tier.role}</p>
                <ul class="mt-6 flex flex-col gap-2.5">
                  {tier.perks.map((p) => (
                    <li class="flex items-start gap-2.5 text-[0.9375rem]">
                      <svg class={`mt-0.5 h-4 w-4 shrink-0 ${tier.highlight ? "text-on-accent" : "text-lime"}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
                      <span class={tier.highlight ? "text-on-accent/90" : "text-white/85"}>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <!-- recognition & fun -->
          <div class="stagger mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {recognition.map((r) => (
              <div class="rounded-2xl bg-white/[0.04] p-6 ring-1 ring-white/10">
                <h3 class="text-base font-bold tracking-tight text-white">{r.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-white/65">{r.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================== HOW TO ENROLL (PLACEHOLDER) ===================== -->
      <section id="enroll" class="relative overflow-hidden bg-white py-20 lg:py-28">
        <div class="relative z-10 mx-auto max-w-3xl px-6 text-center lg:px-10">
          <div class="reveal">
            <Eyebrow index="05" label="How to enroll" class="justify-center" />
            <h2 class="font-display mt-4 text-[clamp(2.5rem,6vw,4rem)] uppercase leading-[0.92] tracking-[-0.015em] text-gray-900">
              Applications <span class="ed ed-dark">Opening Soon</span>.
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              The online ambassador application is on its way — every applicant is
              reviewed and approved by {school.fund}. Join the waitlist and we'll
              email you the moment enrollment opens.
            </p>
            <div class="mx-auto mt-8 max-w-md">
              <WaitlistForm client:only="react" school={school.name} source="Ambassador waitlist" buttonLabel="Join the waitlist" />
            </div>
            <p class="mt-5 text-sm text-gray-500">
              Questions? Email <a href={`mailto:${enrollEmail}`} class="font-semibold text-lime-dark hover:underline">{enrollEmail}</a>
            </p>
            <a href={donorUrl} class="mt-6 inline-block font-mono text-xs uppercase tracking-[0.06em] text-gray-500 underline-offset-4 hover:text-gray-900 hover:underline">← Back to donor sign-up</a>
          </div>
        </div>
      </section>
    </main>

    <SchoolFooter legalCopy={settings.legalCopy} />
  </div>
</Layout>
