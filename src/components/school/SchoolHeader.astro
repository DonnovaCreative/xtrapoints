---
// Co-brand header for school pages: the school's logo (or a text wordmark),
// an optional nav link, and a CTA. Same fixed-overlay shell as the main site
// header (transparent at top → glass morph on scroll → hide/reveal; see
// src/scripts/header-behavior.ts). Rendered inside the page's themed wrapper,
// so the scrolled glass tint (var(--color-ink)) is the school's ink.
// school.whiteHeader → the light variant (solid-ish white, for colored logos).
import CtaButton from "@/components/CtaButton.astro";
import type { School } from "@/data/schools";

export interface Props {
  school: School;
  /** Right-side button. */
  cta?: { label: string; href: string };
  /** Secondary text link (e.g. cross-link to the other school page). */
  nav?: { label: string; href: string };
}
const { school, cta, nav } = Astro.props;

const white = school.whiteHeader ?? false;
const variant = white ? "light" : "dark";

// Logo height (inline, so the custom slider can use any px). Header row: fixed
// 68px bar (default) or "hug the logo" — no fixed height, just vertical padding
// (0 when the logo file already carries its own margin). --header-h is set on the
// page's themed wrapper to match, so the hero's top offset stays in sync.
const logoH = school.logoHeightPx ?? 28;
const hug = school.headerHug ?? false;
const padPx = school.headerPadPx ?? 16;
const rowClass = hug ? "" : "h-[var(--header-h)]";
const rowStyle = hug ? `padding-top:${padPx}px;padding-bottom:${padPx}px;` : undefined;
const logoStyle = `height:${logoH}px;width:auto;`;
const navClass = white
  ? "text-gray-600 hover:text-gray-900"
  : "text-white/80 hover:text-white";
const wordName = white ? "text-gray-900" : "text-white";
const wordMascot = white ? "text-gray-500" : "text-white/55";
---

<header data-site-header data-variant={variant} class="site-header fixed inset-x-0 top-0 z-50">
  <div class:list={["mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 lg:px-10", rowClass]} style={rowStyle}>
    <a href={`/schools/${school.slug}`} class="flex items-center gap-3" aria-label={school.short}>
      {school.logo ? (
        <Fragment>
          {school.logoBadge ? (
            <span class="flex items-center justify-center rounded-lg bg-white px-2.5 py-1.5">
              <img src={school.logo} alt={school.name} style={logoStyle} />
            </span>
          ) : (
            <img src={school.logo} alt={school.name} style={logoStyle} />
          )}
          {school.logoLockup && (
            <span
              class={`border-l pl-3 text-[0.9375rem] font-bold leading-tight tracking-tight ${wordName} ${
                white ? "border-gray-200" : "border-white/20"
              }`}
            >
              {school.short}
            </span>
          )}
        </Fragment>
      ) : (
        <span class={`flex items-center gap-2 ${wordName}`}>
          <svg class="h-6 w-6 text-lime" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><ellipse cx="12" cy="16" rx="5" ry="4.2"/><circle cx="6.2" cy="10.5" r="2.1"/><circle cx="10" cy="7.2" r="2.1"/><circle cx="14" cy="7.2" r="2.1"/><circle cx="17.8" cy="10.5" r="2.1"/></svg>
          <span class="text-sm font-bold leading-none tracking-tight">{school.short}<br /><span class={`font-mono text-[0.625rem] font-normal uppercase tracking-[0.12em] ${wordMascot}`}>{school.mascot}</span></span>
        </span>
      )}
    </a>
    <div class="flex items-center gap-5">
      {nav && (
        <a href={nav.href} class={`hidden text-sm font-semibold transition-colors sm:inline ${navClass}`}>{nav.label}</a>
      )}
      {cta && (
        <CtaButton href={cta.href} variant="lime" glow={false} class="!px-5 !py-2.5 !text-sm">{cta.label}</CtaButton>
      )}
    </div>
  </div>
</header>

<style>
  /* Same shell states as Header.astro (driven by header-behavior.ts). The light
     variant starts on a soft white (not fully transparent) so colored school
     logos always sit on a workable background. */
  .site-header {
    border-bottom: 1px solid transparent;
    transition:
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 0.3s ease,
      border-color 0.3s ease,
      backdrop-filter 0.3s ease,
      box-shadow 0.3s ease;
  }
  .site-header[data-hidden] {
    transform: translateY(-100%);
  }
  .site-header[data-variant="light"] {
    background: rgba(255, 255, 255, 0.92);
    border-color: var(--color-gray-100);
  }
  .site-header[data-scrolled] {
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .site-header[data-variant="dark"][data-scrolled] {
    background: color-mix(in srgb, var(--color-ink) 82%, transparent);
    border-color: rgba(255, 255, 255, 0.08);
  }
  .site-header[data-variant="light"][data-scrolled] {
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 8px 24px -16px rgba(0, 0, 0, 0.15);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>

<script>
  import "@/scripts/header-behavior";
</script>
