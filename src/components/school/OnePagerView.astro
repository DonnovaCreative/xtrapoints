---
// =============================================================================
// Co-branded SALES ONE-PAGER — the print/PDF sell sheet, re-skinned per school.
//
// This is the HTML source of truth for /schools/<slug>/one-pager.pdf (rendered
// to PDF on demand by one-pager.pdf.ts via headless Chromium). It reads the SAME
// Sanity data as the landing pages and re-skins through the theme tokens, so a
// new school gets its branded sell sheet automatically — no manual design.
//
// Built to match the Figma source 1:1 (file W4w45f3JV7E4AFSiFSymdO, node 1:118).
// The design is authored in Figma's native 612×792 coordinate space (US-Letter
// in points), so the markup below uses those exact px values inside `.op-canvas`,
// which is then scaled to fill the real 8.5in × 11in sheet. Typography is
// Inter Display (self-hosted, /public/fonts) + Space Mono. Brand colors:
//   primary   → var(--color-lime)      (green in the reference)
//   secondary → var(--color-accent-2)  (yellow — CTA button + chevron bullets)
//   deep      → darken(primary, .68)   (dark-green: hero-left, phone, footer)
// so it holds for single-color schools too (secondary falls back to a primary tint).
// =============================================================================
import Layout from "@/layouts/Layout.astro";
import { schoolThemeVars, darken, type School } from "@/data/schools";
import { brand } from "@/config/brand";

// Rendered co-branded sales one-pager. Extracted so it's shared by the static
// route (src/pages/schools/[school]/one-pager.astro, published) and the
// secret-gated draft preview (src/pages/preview/schools/[slug]/one-pager.astro) —
// which is how sales previews/downloads a sell sheet before the page is published.
// Takes the resolved school + the PDF link (differs per route) as props.
interface Props {
  school: School;
  /** Where "Download PDF" points — the static PDF route or the preview PDF route. */
  pdfHref: string;
}
const { school, pdfHref } = Astro.props;
const t = school.theme;
const deep = darken(t.primary, 0.68); // the dark-green "#002e18" role
const canvasStyle = schoolThemeVars(t) + `--op-deep:${deep};`;

// Dot texture (matches the supplied Dot grid.svg: r=0.375, 7.75px pitch).
// Rendered as INLINE VECTOR circles rather than a CSS gradient or <img>, so
// Chromium keeps it crisp in the PDF instead of rasterizing → blurring it.
const DOT_R = 0.375;
const DOT_GAP = 7.75;
const dotGrid = (w: number, h: number): string => {
  let s = "";
  for (let y = DOT_R; y <= h; y += DOT_GAP) {
    for (let x = DOT_R; x <= w; x += DOT_GAP) {
      s += `<circle cx="${+x.toFixed(3)}" cy="${+y.toFixed(3)}" r="${DOT_R}"/>`;
    }
  }
  return s;
};
const heroDots = dotGrid(612, 260);
const footerDots = dotGrid(612, 130);

// The phone-header mark is tinted WHITE via a CSS mask. Browsers won't apply a
// cross-origin mask image (marks live on the Sanity CDN), so fetch the SVG at
// build and inline it as a same-origin data URI (same trick as SchoolPhone).
let maskStyle = "";
if (school.mark) {
  let maskSrc = school.mark;
  if (/^https?:\/\//.test(school.mark)) {
    try {
      const svg = await fetch(school.mark).then((r) => r.text());
      maskSrc = `data:image/svg+xml,${encodeURIComponent(svg)}`;
    } catch {
      maskSrc = school.mark;
    }
  }
  maskStyle = `mask:url("${maskSrc}") center/contain no-repeat;-webkit-mask:url("${maskSrc}") center/contain no-repeat;background:#fff;`;
}
---

<Layout
  title={`${school.short} × ${brand.name} — Sales One-Pager`}
  description={`Co-branded ${brand.name} sell sheet for ${school.name}.`}
  noindex
>
  <div class="op-stage">
    <!-- Download button — screen only; hidden in the print/PDF render. -->
    <a href={pdfHref} class="op-download noprint">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
      Download PDF
    </a>

    <div class="op-sheet">
      <div class="op-canvas" style={canvasStyle}>
        <!-- ===================== HERO ===================== -->
        <section class="op-hero">
          {school.avatar && (
            <div class="op-watermark" aria-hidden="true">
              <img src={school.avatar} alt="" />
            </div>
          )}
          <svg class="op-hero-dots" viewBox="0 0 612 260" width="612" height="260" fill="#fff" fill-opacity="0.35" preserveAspectRatio="xMinYMin slice" aria-hidden="true" set:html={heroDots}></svg>

          <div class="op-hero-row">
            <!-- Heading & description -->
            <div class="op-hero-copy">
              <img src="/assets/xtrapoint-logo-solid-white.svg" alt={brand.nameSpaced} class="op-xplogo" />
              <div class="op-intro">
                <h1 class="op-h1">Turn everyday purchases into recurring support for your team.</h1>
                <p class="op-lede">
                  {brand.name} helps athletic departments, booster clubs, and alumni
                  associations turn everyday spending into recurring donor revenue —
                  paired with the marketing arm to grow it. From spare-change round-ups
                  to large one-time gifts, every donation strengthens your program.
                </p>
                <ul class="op-chips">
                  <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>$0 upfront cost</li>
                  <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>Live in days</li>
                  <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>No long contracts</li>
                </ul>
              </div>
            </div>

            <!-- Graphic: school lockup + phone + floating chips -->
            <div class="op-graphic">
              {school.logo ? (
                <span class={`op-lockup ${school.logoBadge ? "op-lockup--badge" : "op-lockup--dark"}`}>
                  <img src={school.logo} alt={school.name} />
                </span>
              ) : (
                <span class="op-lockup-text">{school.short}</span>
              )}

              <div class="op-phone-area" aria-hidden="true">
                <!-- phone -->
                <div class="op-phone">
                  <div class="op-phone-island"></div>
                  <div class="op-phone-status"><span class="op-time">9:41</span><span class="op-staticons"></span></div>
                  <div class="op-phone-head">
                    {maskStyle ? (
                      <span class="op-phone-mark" style={maskStyle}></span>
                    ) : school.avatar ? (
                      <span class="op-phone-avatar"><img src={school.avatar} alt="" /></span>
                    ) : (
                      <span class="op-phone-letter">{school.fund.charAt(0)}</span>
                    )}
                    <span class="op-phone-burger"><span></span><span></span><span></span></span>
                  </div>
                  <div class="op-phone-body">
                    <div class="op-donation">
                      <p class="op-mono-eyebrow">Next minimum donation</p>
                      <p class="op-amt"><span class="op-amt-cur">$</span>15.00</p>
                      <p class="op-date">10&nbsp;&nbsp;/&nbsp;&nbsp;31&nbsp;&nbsp;/&nbsp;&nbsp;2026</p>
                      <div class="op-progress"><span></span></div>
                      <div class="op-addcard">+ Add another account</div>
                    </div>
                    <div class="op-quick">
                      <p>Looking to give a little extra?</p>
                      <div class="op-quick-row">
                        <span>$5</span><span class="on">$25</span><span>$50</span><span>$100</span>
                      </div>
                    </div>
                    <div class="op-give">Give a one-time Donation</div>
                  </div>
                </div>

                <!-- floating chips -->
                <div class="op-chip op-chip--roundup">
                  <span class="op-chip-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></span>
                  <span class="op-chip-tx"><span class="op-chip-l">Round-up</span><span class="op-chip-v">$0.43</span></span>
                </div>
                <div class="op-chip op-chip--recurring">
                  <span class="op-chip-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7M21 4v5h-5"/></svg></span>
                  <span class="op-chip-tx"><span class="op-chip-l">Recurring</span><span class="op-chip-v">Monthly</span></span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ===================== BODY ===================== -->
        <div class="op-body-content">
          <!-- Outcome -->
          <div class="op-outcome">
            <div class="op-outcome-left">
              <p class="op-lead"><span>The outcome: </span><span class="op-accent">recurring donors you wouldn't otherwise have.</span></p>
              <p class="op-p">Boosters, alumni, and fans want to give — they just want it to be easy. {brand.name} captures the small recurring gifts you'd otherwise leave on the table, turning one-off donors into a predictable revenue stream you can plan a season around.</p>
            </div>
            <ul class="op-checklist">
              <li><span class="op-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>Recurring revenue you can forecast — not a single year-end scramble to close the books.</span></li>
              <li><span class="op-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>A new pipeline of donors who'd never have written a check, now giving automatically every day.</span></li>
              <li><span class="op-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><span>More of every dollar reaches your program — lower transaction fees than competing round-up platforms.</span></li>
            </ul>
          </div>

          <!-- Two feature columns -->
          <div class="op-cols">
            <div class="op-col op-col--narrow">
              <div class="op-col-head">
                <p class="op-eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>Fast to Market</p>
                <p class="op-col-h">Live in hours, not quarters.</p>
                <p class="op-p">Done-for-you onboarding means zero-touch setup on your end — no setup fees, no long contracts. Your supporters download the app, link an account, and start contributing. You're live in days, not the next budget cycle.</p>
              </div>
              <div class="op-bullet"><span class="op-chev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span><p><b>Zero implementation cost</b> and no IT lift for your staff.</p></div>
              <div class="op-bullet"><span class="op-chev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span><p><b>Branded app in your colors</b> — instant transparency for donors.</p></div>
            </div>
            <div class="op-col">
              <div class="op-col-head">
                <p class="op-eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 14v-3zM3 11v3M9 12.5V17a2 2 0 0 0 4 0"/></svg>Marketing Support</p>
                <p class="op-col-h">A full marketing arm — without the headcount.</p>
                <p class="op-p">Not every department has a 20-person comms team. For the program where one person handles everything, {brand.name} includes done-for-you marketing campaigns that drive more supporters to your platform — so a one-admin shop can reach donors like a program with a full agency.</p>
              </div>
              <div class="op-bullet"><span class="op-chev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span><p><b>Pre-built campaign playbooks</b> — kickoff, year-end, championship runs.</p></div>
              <div class="op-bullet"><span class="op-chev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span><p><b>Automated re-engagement</b> that wins back lapsed supporters on its own.</p></div>
            </div>
          </div>

          <!-- Ambassador band -->
          <div class="op-ambassador">
            <p class="op-eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V4s-1 1-4 1-5-2-8-2-4 1-4 1zM4 22v-7"/></svg>Ambassador Program</p>
            <p class="op-ambassador-h">Put your students to work for your program.</p>
            <p class="op-p">The Ambassador Program turns students into a grassroots growth engine — driving app sign-ups, verified registrations, and recurring donors through channels staff outreach can't reach: Greek life, tailgates, orientation. It's low-cost, always-on marketing that builds school pride today and a pipeline of future alumni donors who give for years after they graduate</p>
          </div>

          <!-- Product features -->
          <div class="op-product">
            <p class="op-eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 4.8L20 8l-4 3.6L17 18l-5-2.6L7 18l1-6.4L4 8l5.6-1.2z"/></svg>Product Features</p>
            <p class="op-p"><b>One-time, recurring &amp; round-up giving</b> · weekly / monthly / quarterly / annual schedules · <b>cards, Apple&nbsp;Pay &amp; bank transfers</b> · tribute &amp; team giving in honor or memory · a branded mobile app · and a <b>single dashboard</b> tracking every donor, campaign, and transaction with real-time activity and lifetime-value insight.</p>
          </div>
        </div>

        <!-- ===================== FOOTER ===================== -->
        <footer class="op-footer">
          <svg class="op-footer-dots" viewBox="0 0 612 130" width="612" height="130" fill="#fff" fill-opacity="0.28" preserveAspectRatio="xMinYMin slice" aria-hidden="true" set:html={footerDots}></svg>
          <div class="op-footer-left">
            <p class="op-cta-h">Ready to launch your program's giving platform?</p>
            <p class="op-cta-p">Partnering is simple: we provide the platform, the toolkit, and the coaching — your campus brings the energy. Let's design a kickoff for your next season.</p>
            <p class="op-copyright">© 2026 LaCore Payments Technologies, Inc. All rights reserved.</p>
          </div>
          <div class="op-footer-right">
            <a href={`https://${brand.domain}`} class="op-cta-btn">Learn more<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg></a>
            <a href={`mailto:${brand.salesEmail}`} class="op-cta-mail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>{brand.salesEmail}</a>
          </div>
        </footer>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* ---- Inter Display (self-hosted) ---- */
  @font-face { font-family: "Inter Display"; font-weight: 400; font-style: normal; font-display: swap; src: url("/fonts/InterDisplay-Regular.woff2") format("woff2"); }
  @font-face { font-family: "Inter Display"; font-weight: 500; font-style: normal; font-display: swap; src: url("/fonts/InterDisplay-Medium.woff2") format("woff2"); }
  @font-face { font-family: "Inter Display"; font-weight: 600; font-style: normal; font-display: swap; src: url("/fonts/InterDisplay-SemiBold.woff2") format("woff2"); }
  @font-face { font-family: "Inter Display"; font-weight: 700; font-style: normal; font-display: swap; src: url("/fonts/InterDisplay-Bold.woff2") format("woff2"); }
  @font-face { font-family: "Inter Display"; font-weight: 800; font-style: normal; font-display: swap; src: url("/fonts/InterDisplay-ExtraBold.woff2") format("woff2"); }

  /* ---- Page / print setup ---- */
  @page { size: Letter; margin: 0; }
  .op-stage {
    display: flex;
    justify-content: center;
    padding: 24px;
    background: #e5e7eb;
    min-height: 100vh;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .op-sheet {
    position: relative;
    width: 8.5in;   /* 816px */
    height: 11in;   /* 1056px */
    background: #fff;
    overflow: hidden;
    box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.4);
  }
  /* The design is authored at Figma's native 612×792 space, then scaled to fill
     the 8.5×11in sheet (816/612 ≈ 1.3334; a hair over to avoid a sub-px seam). */
  .op-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 612px;
    height: 792px;
    transform: scale(1.3334);
    transform-origin: top left;
    display: flex;
    flex-direction: column;
    font-family: "Inter Display", "Inter", sans-serif;
    color: #000;
    -webkit-font-smoothing: antialiased;
  }
  @media print {
    .op-stage { padding: 0; background: #fff; display: block; min-height: 0; }
    .op-sheet { box-shadow: none; }
    .noprint { display: none !important; }
  }
  .op-download {
    position: fixed; right: 20px; bottom: 20px; z-index: 100;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 12px 20px; border-radius: 999px;
    background: #111827; color: #fff; font-weight: 700; font-size: 14px;
    font-family: "Inter Display", sans-serif;
    box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.5);
  }
  .op-download svg { width: 18px; height: 18px; }

  /* ======================= HERO ======================= */
  .op-hero {
    position: relative;
    overflow: hidden;
    padding: 16px 20px;
    /* Single OPAQUE gradient — no transparent stops. Chromium exports gradients
       that fade to/from transparent as PDF soft-masks, which some viewers
       (Preview/Quartz, PDFium) drop; opaque stops render everywhere. */
    background: linear-gradient(to right, var(--op-deep) 0%, var(--op-deep) 16%, var(--color-lime) 58%, var(--color-accent-2) 100%);
    border-radius: 0 0 16px 16px;
  }
  /* Subtle dot texture — inline vector (crisp in PDF, no rasterization).
     Kept fully opaque: element-level opacity would re-introduce the soft-mask
     that some PDF viewers drop. Subtlety comes from the tiny dot size. */
  .op-hero-dots {
    position: absolute; top: 0; left: 0; width: 612px; height: 260px;
    z-index: 0; pointer-events: none;
  }
  .op-watermark {
    position: absolute; left: 300px; top: 50%; transform: translateY(-50%);
    width: 282px; height: 282px; opacity: 0.22; z-index: 1; pointer-events: none;
  }
  .op-watermark img { width: 100%; height: 100%; object-fit: contain; }
  .op-hero-row {
    position: relative; z-index: 2;
    display: flex; gap: 16px; align-items: stretch;
  }
  .op-hero-copy { width: 332px; flex-shrink: 0; padding-right: 14px; display: flex; flex-direction: column; gap: 14px; }
  .op-xplogo { height: 30px; width: auto; align-self: flex-start; }
  .op-intro { display: flex; flex-direction: column; gap: 8px; }
  .op-h1 {
    font-weight: 700; font-size: 24px; line-height: 1.0;
    letter-spacing: 0.24px; color: #fff;
  }
  .op-lede { font-weight: 400; font-size: 9px; line-height: 1.5; color: #fff; }
  .op-chips { display: flex; gap: 6px; }
  .op-chips li {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 1px 5px; border: 0.5px solid #fff; border-radius: 16px;
    font-weight: 600; font-size: 8px; color: #fff; white-space: nowrap;
  }
  .op-chips svg { width: 8px; height: 8px; }

  /* ---- Graphic column ---- */
  .op-graphic { flex: 1 0 0; min-width: 0; position: relative; display: flex; flex-direction: column; align-items: flex-end; gap: 14px; }
  .op-lockup { display: block; }
  .op-lockup img { height: 32px; width: auto; display: block; }
  .op-lockup--badge { background: #fff; border-radius: 6px; padding: 4px 7px; }
  .op-lockup-text { font-weight: 800; font-size: 18px; color: var(--op-deep); }

  .op-phone-area { position: absolute; top: 40px; right: -6px; left: 0; bottom: -40px; }

  /* phone — aspect ~0.46 (116×252), rotated, clipped by the hero bottom */
  .op-phone {
    position: absolute; top: 0; right: 38px;
    width: 116px; height: 252px;
    transform: rotate(-4deg); transform-origin: top center;
    background: #fff; border: 3px solid #000; border-radius: 14px;
    overflow: hidden; display: flex; flex-direction: column;
  }
  .op-phone-island { position: absolute; top: 6px; left: 50%; transform: translateX(-50%); width: 40px; height: 11px; border-radius: 6px; background: #000; z-index: 3; }
  .op-phone-status { position: absolute; top: 0; left: 0; right: 0; height: 24px; display: flex; align-items: center; justify-content: space-between; padding: 0 9px; z-index: 2; }
  .op-time { font-size: 5px; font-weight: 700; color: #fff; }
  .op-staticons { width: 21px; height: 4px; border-radius: 1px; background: #fff; opacity: 0.9; }
  .op-phone-head {
    background: var(--color-lime);
    padding: 24px 4px 7px 5px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .op-phone-mark { width: 16px; height: 16px; display: block; }
  .op-phone-avatar { width: 16px; height: 16px; border-radius: 3px; background: #fff; display: inline-flex; align-items: center; justify-content: center; overflow: hidden; }
  .op-phone-avatar img { width: 13px; height: 13px; object-fit: contain; }
  .op-phone-letter { width: 16px; height: 16px; border-radius: 3px; background: #fff; color: var(--color-lime); font-weight: 800; font-size: 10px; display: inline-flex; align-items: center; justify-content: center; }
  .op-phone-burger { display: inline-flex; flex-direction: column; gap: 1.5px; padding: 2px; }
  .op-phone-burger span { width: 7px; height: 0.8px; background: #fff; border-radius: 1px; }
  .op-phone-body { display: flex; flex-direction: column; gap: 6px; padding: 7px; }
  .op-donation { background: #f3f5fc; border: 0.3px solid #d9dded; border-radius: 6px; padding: 9px; display: flex; flex-direction: column; gap: 7px; }
  .op-mono-eyebrow { font-family: "Space Mono", monospace; font-size: 4.5px; letter-spacing: 0.27px; text-transform: uppercase; color: #495379; }
  .op-amt { font-weight: 700; font-size: 15.5px; line-height: 1.05; letter-spacing: -0.3px; color: #060a18; }
  .op-amt-cur { font-weight: 500; font-size: 10px; color: #495379; }
  .op-date { font-family: "Space Mono", monospace; font-size: 4.5px; color: #495379; }
  .op-progress { height: 1.8px; border-radius: 99px; background: #d9dded; overflow: hidden; }
