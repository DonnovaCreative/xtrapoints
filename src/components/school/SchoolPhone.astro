---
// Co-branded round-up app mockup (zero JS; CSS-only progress fill).
// Colors come from the page's overridden tokens, so it re-skins per school.
export interface Props {
  fund: string;
  mascot: string;
}
const { fund, mascot } = Astro.props;
const quick = ["$5", "$25", "$50", "$100"];
---

<div class="relative mx-auto w-full max-w-[300px]">
  <!-- floating round-up chip -->
  <div
    class="anim-float-1 absolute -right-4 top-20 z-20 hidden items-center gap-2.5 rounded-xl border border-gray-100 bg-white px-3.5 py-2.5 shadow-xl sm:flex"
  >
    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-lime-soft text-lime-dark">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    <span>
      <span class="block font-mono text-[10px] uppercase tracking-[0.06em] text-gray-500">Round-up</span>
      <span class="block text-base font-bold tracking-tight text-gray-900">$0.43</span>
    </span>
  </div>

  <!-- device -->
  <div class="relative z-10 overflow-hidden rounded-[2.25rem] border-[6px] border-gray-900 bg-white shadow-[0_40px_80px_-30px_rgba(0,0,0,0.55)]">
    <!-- status bar -->
    <div class="flex items-center justify-between px-6 pb-2 pt-4 text-xs font-semibold text-gray-900">
      <span>9:41</span>
      <span class="flex items-center gap-1 text-gray-400">●&nbsp;▪&nbsp;▮</span>
    </div>

    <!-- orange app header w/ paw -->
    <div class="flex items-center justify-between bg-lime px-5 py-3.5">
      <span class="flex items-center gap-2 text-ink">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><ellipse cx="12" cy="16" rx="5" ry="4.2"/><circle cx="6.2" cy="10.5" r="2.1"/><circle cx="10" cy="7.2" r="2.1"/><circle cx="14" cy="7.2" r="2.1"/><circle cx="17.8" cy="10.5" r="2.1"/></svg>
        <span class="text-[0.8125rem] font-bold tracking-tight">{fund}</span>
      </span>
      <svg class="h-4 w-4 text-ink/80" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </div>

    <div class="flex flex-col gap-3 p-4">
      <!-- donation card -->
      <div class="rounded-2xl bg-gray-50 p-4 text-center">
        <p class="font-mono text-[10px] uppercase tracking-[0.06em] text-gray-500">Next minimum donation</p>
        <p class="mt-1 text-[2.25rem] font-bold leading-none tracking-tight text-gray-900">$15.00</p>
        <p class="mt-1 font-mono text-[10px] text-gray-500">10 / 31 / 2026</p>
        <div class="mx-auto mt-3 h-1.5 w-full overflow-hidden rounded-full bg-gray-200">
          <div class="xp-fill h-full rounded-full bg-lime"></div>
        </div>
        <div class="mt-3 rounded-lg bg-ink py-2.5 text-xs font-semibold text-white">+ Add another card</div>
      </div>

      <!-- quick give (accent panel) -->
      <div class="rounded-2xl bg-lime p-4 text-center">
        <p class="mb-3 text-xs font-bold text-ink">Looking to give a little extra?</p>
        <div class="grid grid-cols-4 overflow-hidden rounded-full bg-ink/15">
          {quick.map((a, i) => (
            <span class={`py-1.5 text-xs font-bold ${i === 0 ? "rounded-full bg-white text-lime-dark" : "text-ink"}`}>{a}</span>
          ))}
        </div>
        <div class="mt-3 rounded-lg bg-ink/85 py-2.5 text-xs font-bold text-white">Give a one-time donation</div>
      </div>

      <!-- share -->
      <div class="rounded-2xl bg-gray-50 p-4 text-center">
        <span class="mx-auto mb-2 flex h-9 w-9 items-center justify-center rounded-xl bg-lime text-ink">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        </span>
        <p class="text-[10px] leading-snug text-gray-600">Tell others, so they can donate to the {mascot} too!</p>
      </div>
    </div>
  </div>
</div>

<style>
  .xp-fill { width: 0; animation: xpFill 2s 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
  @keyframes xpFill { to { width: 72%; } }
  @media (prefers-reduced-motion: reduce) { .xp-fill { width: 72%; animation: none; } }
</style>
