---
import RoundUpDemo from "./RoundUpDemo";
import AudienceGallery from "./AudienceGallery";
import FilmPlayer from "./FilmPlayer.astro";
import PlatformShowcase from "./PlatformShowcase.astro";
import MarketingShowcase from "./MarketingShowcase.astro";
import AmbassadorWall from "./AmbassadorWall";
const arrow = "M4 12h16m-6-6 6 6-6 6";
const faqs = [
  {
    question: "How does round-up giving work?",
    answer:
      "Supporters link an eligible account and choose the program they want to support. Everyday purchases are rounded up to the next dollar, and the difference accumulates toward a donation. A $4.65 purchase, for example, creates a $0.35 round-up.",
  },
  {
    question: "Can supporters give in other ways?",
    answer:
      "Yes. Alongside round-ups, XtraPoint supports one-time gifts and recurring donations, so supporters can choose a way to give that works for them.",
  },
  {
    question: "What does it take to get started?",
    answer:
      "Start with a conversation about your program. Our team walks you through the platform, confirms the right setup, and helps prepare your branded experience and launch. There is no implementation cost.",
  },
  {
    question: "Is this only for college athletics?",
    answer:
      "XtraPoint works with athletic departments, booster clubs, alumni associations, schools, youth sports, and community organizations. Tell us about your community and we’ll explore the right fit together.",
  },
  {
    question: "What marketing support is available?",
    answer:
      "Launch resources can include campaign materials, social and email content, and ambassador tools. We’ll walk you through the resources and services available for your program during your introduction.",
  },
];
---

<main id="main-content">
  <section class="home-hero" aria-labelledby="hero-heading">
    <div class="hero-image">
      <img
        src="/images/brand-refresh/otto-volleyball-team.webp"
        srcset="/images/brand-refresh/otto-volleyball-team-720.webp 720w, /images/brand-refresh/otto-volleyball-team.webp 1536w"
        sizes="(max-width:700px) 100vw, 80vw"
        width="1536"
        height="1024"
        alt="Otto the Otter with a volleyball team, gathered together on their home court."
        fetchpriority="high"
      />
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="xp-wrap hero-content">
      <p class="hero-intro">
        <span aria-hidden="true"></span> A little change can change the game.
      </p>
      <h1 id="hero-heading">
        <span>For the team</span>
        <span class="hero-brush">behind</span>
        <span>the team.</span>
      </h1>
      <p class="hero-description">
        Turn everyday spending into ongoing support. Round-up giving, powerful
        fundraising tools, and a team that helps yours grow.
      </p>
      <div class="hero-actions">
        <a class="xp-btn" href="/contact">
          Get started{" "}
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d={arrow} />
          </svg>
        </a>
        <a class="hero-secondary" href="#how-it-works">
          See how it works
        </a>
      </div>
      <p class="hero-reassurance">
        No implementation cost. Built around your community.
      </p>
    </div>
    <div class="hero-gift" aria-label="Example: 35 cents of round-up support">
      <span class="gift-symbol" aria-hidden="true">
        +
      </span>
      <span>
        <small>Small change. Real possibility.</small>
        <strong>
          $0.35 <span>for your team</span>
        </strong>
        <em>Illustrative round-up</em>
      </span>
    </div>
    <div class="hero-bottom xp-wrap">
      <FilmPlayer
        id="brand-film"
        src="/videos/brand-refresh/xtrapoint-brand-film.mp4"
        poster="/images/brand-refresh/stadium-film-poster.webp"
        title="For the team behind the team"
        label="Meet XtraPoint"
      />
      <a
        class="hero-scroll"
        href="#how-it-works"
        aria-label="Explore how XtraPoint works"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          aria-hidden="true"
        >
          <path d="M12 4v16m-6-6 6 6 6-6" />
        </svg>{" "}
        Keep the good going
      </a>
    </div>
  </section>
  <div class="value-strip">
    <div class="xp-wrap">
      <p>
        <strong>Everyday giving.</strong> Season-long possibility.
      </p>
      <div>
        <span>Round-ups</span>
        <span>Recurring gifts</span>
        <span>One-time donations</span>
      </div>
    </div>
  </div>

  <section class="xp-section giving-section" id="how-it-works">
    <div class="xp-wrap giving-layout">
      <div class="giving-copy">
        <p class="section-note">How it works</p>
        <h2 class="xp-heading">
          It starts with
          <br />
          the everyday.
        </h2>
        <p class="xp-body">
          A coffee on the way to work. Groceries for the week. Lunch before the
          game. The purchases your supporters already make can do a little more.
        </p>
        <ol class="giving-steps">
          <li>
            <span>1</span>
            <div>
              <h3>Choose your team.</h3>
              <p>Supporters connect with the program they care about.</p>
            </div>
          </li>
          <li>
            <span>2</span>
            <div>
              <h3>Link an account.</h3>
              <p>Connect an eligible account and turn on round-ups.</p>
            </div>
          </li>
          <li>
            <span>3</span>
            <div>
              <h3>Let the little things add up.</h3>
              <p>Spare change accumulates into ongoing support.</p>
            </div>
          </li>
        </ol>
        <a class="xp-text-link" href="/contact">
          Explore it with our team <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="giving-demo">
        <RoundUpDemo client:visible />
      </div>
    </div>
  </section>

  <section class="community-section xp-section" id="community">
    <div class="xp-wrap">
      <p class="section-note">Who we serve</p>
      <div class="section-heading-row">
        <h2 class="xp-heading">
          Different teams.
          <br />
          Same heart.
        </h2>
        <p class="xp-body">
          For everyone who shows up. And every community with something worth
          supporting.
        </p>
      </div>
      <AudienceGallery client:visible />
    </div>
  </section>

  <section class="platform-section xp-section" id="features">
    <div class="xp-wrap">
      <div class="platform-intro">
        <p class="section-note">The tools behind the support</p>
        <h2 class="xp-heading">
          Your mission.
          <br />
          More momentum.
        </h2>
        <p class="xp-body">
          Bring giving, your supporters, and your campaigns together. Less time
          connecting the dots. More time moving your program forward.
        </p>
      </div>
      <PlatformShowcase />
    </div>
  </section>

  <section
    class="marketing-section xp-section"
    id="marketing"
    aria-labelledby="marketing-heading"
  >
    <div class="xp-wrap">
      <p class="section-note">Marketing support</p>
      <div class="section-heading-row marketing-intro">
        <h2 class="xp-heading" id="marketing-heading">
          Your brand.
          <br />
          Ready to rally.
        </h2>
        <div class="section-support-copy">
          <p class="xp-body">
            Posters and one-pagers. Social posts, flyers, and event materials.
            Give your community more ways to discover your program, with a
            marketing portal that keeps it all together.
          </p>
          <a class="xp-text-link" href="/contact">
            Plan your launch <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <MarketingShowcase />
    </div>
  </section>

  <section
    class="ambassador-section xp-section"
    id="ambassadors"
    aria-labelledby="ambassador-heading"
  >
    <div class="xp-wrap">
      <p class="section-note">Ambassador programs</p>
      <div class="section-heading-row ambassador-intro">
        <h2 class="xp-heading" id="ambassador-heading">
          Your community.
          <br />
          In their own words.
        </h2>
        <div class="section-support-copy">
          <p class="xp-body">
            A campus walk. A courtside conversation. A story from the dorm. Help
            your ambassadors turn everyday moments into content that brings more
            people into your program.
          </p>
          <a class="xp-text-link" href="/contact">
            Build your ambassador program <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
    <div class="ambassador-wall-wrap">
      <AmbassadorWall client:visible />
    </div>
    <div class="xp-wrap ambassador-bottom">
      <p>
        <strong>Made by your community. Made to connect.</strong>
        <span>
          Give ambassadors the resources, creative direction, and encouragement
          to share your program in a way that feels like them.
        </span>
      </p>
      <span class="xp-caption">
        Campus life. Game day. Everywhere in between.
      </span>
    </div>
  </section>

  <section class="film-feature">
    <img
      src="/images/brand-refresh/stadium-film-poster.webp"
      width="1920"
      height="1080"
      alt="A stadium lit up for game day."
      loading="lazy"
    />
    <div class="film-feature-shade" aria-hidden="true"></div>
    <div class="xp-wrap">
      <div>
        <p class="section-note">This is what we're here for.</p>
        <h2 class="xp-heading">
          The big moments.
          <br />
          The little things.
          <br />
          All of it.
        </h2>
        <p>
          Every team has people behind it.
          <br />
          We help them keep showing up.
        </p>
        <FilmPlayer
          id="story-film"
          src="/videos/brand-refresh/xtrapoint-brand-film.mp4"
          poster="/images/brand-refresh/stadium-film-poster.webp"
          title="For the team behind the team"
        />
      </div>
    </div>
  </section>

  <section class="faq-section xp-section">
    <div class="xp-wrap faq-layout">
      <div>
        <p class="section-note">A few good questions</p>
        <h2 class="xp-heading">
          Let's clear
          <br />
          things up.
        </h2>
        <a href="/contact" class="xp-text-link">
          Talk with our team <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>
              {faq.question}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="home-final">
    <div class="xp-wrap">
      <div>
        <p class="section-note">Your next chapter starts here.</p>
        <h2 class="xp-heading">
          Let's build
          <br />
          something good.
        </h2>
      </div>
      <div>
        <p>
          More people taking part.
          <br />
          More support for what matters.
        </p>
        <a class="xp-btn" href="/contact">
          Get started{" "}
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d={arrow} />
          </svg>
        </a>
        <span class="final-note">
          A conversation. A plan. A team behind you.
        </span>
      </div>
    </div>
  </section>
</main>
