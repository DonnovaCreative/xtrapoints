---
import { brand } from "@/config/brand";

// Working company content from Corey's September 8 About-page brief. All
// unconfirmed photography, biographies, logos, quotes and awards stay clearly
// identified as planning slots, and this component is used only by /about.
const capabilities = [
  {
    title: "Marketing & campaigns",
    items: [
      "Launch planning",
      "Campaign materials",
      "Outreach resources",
      "Social and sharing content",
    ],
  },
  {
    title: "Brand & design",
    items: [
      "School-branded experiences",
      "Landing pages",
      "Digital creative",
      "Print and presentation materials",
    ],
  },
  {
    title: "Platform & technology",
    items: [
      "Configurable giving platform",
      "Branded donor experiences",
      "Flexible campaigns and giving options",
      "Reporting tools",
    ],
  },
  {
    title: "Ambassador-program tools",
    items: [
      "Program roadmaps and templates",
      "Referral and tracking tools",
      "Staff training",
      "Setup assistance",
    ],
  },
  {
    title: "Implementation & partner support",
    items: [
      "Platform configuration",
      "Onboarding",
      "Team training",
      "Partner coordination and technical support",
    ],
  },
  {
    title: "Donor & payment support",
    items: [
      "Help for people making donations",
      "Donation and payment questions",
      "Payment troubleshooting",
      "Chargeback assistance",
    ],
  },
];

const people = [
  { name: "Dreux Flaherty", initials: "DF" },
  { name: "Corey Donovan", initials: "CD" },
  { name: "Connor Hester", initials: "CH" },
  { name: "Michelle Balch", initials: "MB" },
  { name: "Chris Walker", initials: "CW" },
  { name: "Mike Menefee", initials: "MM" },
  { name: "Jeff Puckett", initials: "JP" },
  { name: "Tim Fuller", initials: "TF" },
];

const culture = [
  ["Ask good questions", "Pretend we have every answer"],
  ["Share the credit", "Bring big egos"],
  ["Bring people together", "Make it someone else’s problem"],
  ["Cheer each other on", "Hoard good ideas"],
  ["Get a little competitive", "Take ourselves too seriously"],
  ["Find a reason to laugh", "Confuse busy with useful"],
];
---

<main id="main-content" class="xp-about">
  <section class="about-opening" aria-labelledby="about-title">
    <div class="about-wrap">
      <aside class="about-preview" aria-label="Design preview notice">
        <span class="preview-status">
          <span aria-hidden="true"></span> Staging preview
        </span>
        <p>
          A look at the structure. Team photography, public roles, and partner
          stories are still in development.
        </p>
      </aside>
      <div class="about-opening-meta">
        <p>About XtraPoint</p>
        <a href="#our-people">
          Meet the people <span aria-hidden="true">↘</span>
        </a>
      </div>
      <h1 id="about-title">
        For the team
        <br />
        behind the team.
      </h1>
      <div class="about-opening-bottom">
        <div class="about-brand-shape" aria-hidden="true">
          <img src={brand.logo.mark} alt="" width="88" height="88" />
          <span>
            Everyone has
            <br />a part to play.
          </span>
        </div>
        <p class="about-opening-copy">
          XtraPoint helps schools turn everyday generosity into ongoing support.
          We bring together round-ups, recurring giving, and tools that help
          school communities take part, so more people have a way to show up for
          the programs they care about.
        </p>
      </div>
    </div>
  </section>

  <section
    id="our-purpose"
    class="about-purpose about-section"
    aria-labelledby="purpose-title"
  >
    <div class="about-wrap">
      <div class="about-split">
        <h2 id="purpose-title">
          Good things happen when people show up for each other.
        </h2>
        <div class="about-copy">
          <p>
            That belief is what brings us together at XtraPoint. Our experience
            spans payments, technology, creative work, and building
            relationships.
          </p>
          <p>
            We’re bringing those different strengths to a shared purpose:
            helping more people support the communities they care about.
          </p>
        </div>
      </div>
      <div class="about-photo-layout" aria-label="Planned company photography">
        <div class="about-photo-slot about-photo-team">
          <span class="photo-slot-corner" aria-hidden="true">
            +
          </span>
          <span class="photo-slot-corner" aria-hidden="true">
            +
          </span>
          <div>
            <span class="about-slot-label">Team photography</span>
            <p>
              The people.
              <br />
              The moments.
              <br />
              The real us.
            </p>
          </div>
          <span class="photo-slot-caption">
            A place for a genuine team moment.
          </span>
        </div>
        <div class="about-photo-aside">
          <div class="about-photo-slot about-photo-candid">
            <span class="about-slot-label">Candid photograph</span>
            <div class="about-candid-mark" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <span class="photo-slot-caption">
              Working together. Being ourselves.
            </span>
          </div>
          <p class="about-editor-note">
            Reserved for original team photography and candid moments from the
            people behind XtraPoint.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    class="about-partners about-section"
    aria-labelledby="partners-title"
  >
    <div class="about-wrap">
      <div class="about-section-intro">
        <p class="about-section-label">The people we’re building with</p>
        <h2 id="partners-title">
          We’re building XtraPoint with people who care deeply about their
          communities.
        </h2>
      </div>
      <div class="about-logo-slots" aria-label="Partner logo placements">
        {[1, 2, 3].map(() => (
          <div class="about-logo-slot">
            <span class="logo-slot-icon" aria-hidden="true"></span>
            <p>Partner logo</p>
            <span>Organization and relationship to be confirmed</span>
          </div>
        ))}
      </div>
      <p class="about-editor-note">
        This module is reserved for organizations ready to be publicly named,
        with an accurate description of each relationship.
      </p>
    </div>
  </section>

  <section
    id="our-capabilities"
    class="about-capabilities about-section"
    aria-labelledby="capabilities-title"
  >
    <div class="about-wrap">
      <div class="about-split">
        <div>
          <p class="about-section-label">Our capabilities</p>
          <h2 id="capabilities-title">
            We bring the creative, technical, and human sides together.
          </h2>
        </div>
        <p class="about-copy">
          Our work spans the platform people use, the materials that introduce
          it, and the support that keeps things moving.
        </p>
      </div>
      <div class="about-capability-grid">
        {capabilities.map((capability) => (
          <article class="about-capability">
            <span class="capability-cross" aria-hidden="true">
              +
            </span>
            <h3>{capability.title}</h3>
            <ul>
              {capability.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <p class="about-capability-note">
        XtraPoint provides ambassador-program templates, technology, training,
        and setup assistance. Each partner independently owns and operates its
        program.
      </p>
    </div>
  </section>

  <section class="about-voices about-section" aria-labelledby="voices-title">
    <div class="about-wrap about-voice-layout">
      <div>
        <p class="about-section-label">Partner voices</p>
        <h2 id="voices-title">
          What it’s like
          <br />
          to work together.
        </h2>
      </div>
      <div class="about-quote-slot">
        <span class="about-slot-label">A future partner story</span>
        <p>
          A space for the experience
          <br />
          in their own words.
        </p>
        <div class="about-quote-attribution">
          <span aria-hidden="true"></span>
          <p>Genuine quotation and attribution to come.</p>
        </div>
      </div>
    </div>
  </section>

  <section
    id="our-people"
    class="about-team about-section"
    aria-labelledby="team-title"
  >
    <div class="about-wrap">
      <div class="about-split">
        <div>
          <p class="about-section-label">Meet the team</p>
          <h2 id="team-title">
            Different strengths.
            <br />A shared sense
            <br />
            of purpose.
          </h2>
        </div>
        <div class="about-copy">
          <p>
            We’re builders, creative thinkers, and people who enjoy bringing
            others together. We like a good question, a better idea, and a
            reason to get everyone around the same table.
          </p>
          <p>
            We take the work seriously, leave room for a laugh, and believe the
            best teams make each other better.
          </p>
        </div>
      </div>
      <div class="about-people-grid">
        {people.map((person, index) => (
          <article class:list={["about-person", `about-person-${index % 4}`]}>
            <div
              class="about-portrait-slot"
              aria-label={`Portrait placement for ${person.name}`}
            >
              <span class="about-person-initials" aria-hidden="true">
                {person.initials}
              </span>
              <span class="about-portrait-status">Portrait to come</span>
            </div>
            <h3>{person.name}</h3>
            <p>Public role and biography in development.</p>
          </article>
        ))}
      </div>
      <details class="about-recognition">
        <summary>
          <span>Future recognition</span>
          <span class="recognition-toggle" aria-hidden="true">
            +
          </span>
        </summary>
        <p>
          Reserved for confirmed awards and industry recognition. This optional
          module will remain unpublished until there is material to share.
        </p>
      </details>
    </div>
  </section>

  <section class="about-culture about-section" aria-labelledby="culture-title">
    <div class="about-wrap">
      <div class="about-split">
        <div>
          <p class="about-section-label">Our culture</p>
          <h2 id="culture-title">
            Good people.
            <br />
            Good work.
            <br />
            Room for a little fun.
          </h2>
        </div>
        <div class="about-copy">
          <p>
            We believe the people you work with should make the work better and
            the day more enjoyable.
          </p>
          <p class="about-editor-note">
            A starting point for our culture story, with room for the rituals,
            rivalries, and running jokes that make it ours.
          </p>
        </div>
      </div>
      <div class="about-culture-table">
        <div class="about-culture-head">
          <h3>What we do</h3>
          <h3>What we don’t</h3>
        </div>
        {culture.map(([doThis, notThis]) => (
          <div class="about-culture-row">
            <p>
              <span aria-hidden="true">+</span>
              {doThis}
            </p>
            <p>
              <span aria-hidden="true">−</span>
              {notThis}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-hello about-section" aria-labelledby="hello-title">
    <div class="about-wrap">
      <p class="about-section-label">Say hello</p>
      <h2 id="hello-title">
        Let’s build something
        <br />
        worth cheering for.
      </h2>
      <div class="about-hello-bottom">
        <p>
          Have an idea, a question, or a reason to connect?
          <br />
          We’d love to hear from you.
        </p>
        <a class="about-hello-button" href="/contact">
          Let’s talk{" "}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M5 12h14M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
      <div class="about-hello-links">
        <a href={`mailto:${brand.salesEmail}`}>{brand.salesEmail}</a>
        <a href="/support">Looking for support?</a>
      </div>
    </div>
  </section>
</main>

<style>
  .xp-about {
    color: var(--xp-text, #000628);
    background: white;
    font-family: var(--font-sans);
  }
  .about-wrap {
    width: min(100% - 96px, 1376px);
    margin-inline: auto;
  }
  .about-section {
    padding-block: clamp(72px, 8vw, 132px);
  }
  .xp-about h1,
  .xp-about h2 {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 1.01;
  }
  .xp-about h2 {
    font-size: clamp(38px, 4.3vw, 68px);
  }
  .xp-about p {
    margin: 0;
  }
  .xp-about a:focus-visible,
  .xp-about summary:focus-visible {
    outline: 3px solid var(--xp-blue, #3898ff);
    outline-offset: 6px;
  }
  .about-opening {
    padding: calc(var(--header-h) + 32px) 0 88px;
    color: white;
    background: var(--xp-navy, #000628);
  }
  .about-preview {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 14px 18px;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 8px;
    color: rgb(255 255 255 / 0.72);
    font-size: 12px;
    line-height: 1.5;
  }
  .preview-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    color: var(--xp-lime, #8bf000);
    font-weight: 600;
  }
  .preview-status > span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .about-opening-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 72px 0 32px;
    font-size: 14px;
  }
  .about-opening-meta > p {
    color: var(--xp-lime, #8bf000);
  }
  .about-opening-meta a {
    display: flex;
    gap: 16px;
    align-items: center;
    text-decoration: none;
    color: white;
  }
  .about-opening-meta a span {
    font-size: 24px;
  }
  .xp-about h1 {
    font-size: clamp(64px, 9vw, 146px);
    text-wrap: balance;
    max-width: 1230px;
    text-transform: uppercase;
  }
  .about-opening-bottom {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    align-items: end;
    gap: 70px;
    margin-top: 64px;
  }
  .about-brand-shape {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .about-brand-shape img {
    width: 66px;
    height: 66px;
  }
  .about-brand-shape span {
    font-size: 16px;
    line-height: 1.4;
    color: rgb(255 255 255 / 0.7);
  }
  .about-opening-copy {
    max-width: 650px;
    font-size: clamp(18px, 1.7vw, 23px);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.8);
  }
  .about-split {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(40px, 9vw, 150px);
    align-items: end;
  }
  .about-copy {
    font-size: 18px;
    line-height: 1.65;
    color: var(--xp-muted, #526075);
  }
  .about-copy p + p {
    margin-top: 22px;
  }
  .about-photo-layout {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 30px;
    margin-top: 64px;
    align-items: start;
  }
  .about-photo-slot {
    position: relative;
    overflow: hidden;
  }
  .about-photo-team {
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px;
    color: var(--xp-navy, #000628);
    background: var(--xp-pale, #e6f1ff);
    border-radius: 8px;
  }
  .about-photo-team > div > p {
    margin-top: 34px;
    font-size: clamp(34px, 4vw, 60px);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .photo-slot-corner {
    position: absolute;
    font-size: 20px;
    font-weight: 300;
  }
  .photo-slot-corner:first-child {
    top: 20px;
    left: 24px;
  }
  .photo-slot-corner:nth-child(2) {
    right: 24px;
    bottom: 20px;
  }
  .about-slot-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    opacity: 0.65;
  }
  .photo-slot-caption {
    display: block;
    font-size: 12px;
    line-height: 1.5;
  }
  .about-photo-team .photo-slot-caption {
    margin-top: 48px;
  }
  .about-photo-aside {
    padding-top: 60px;
  }
  .about-photo-candid {
    height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
    border-radius: 8px;
    background: var(--xp-pale-green, #e1f9c9);
  }
  .about-candid-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    transform: rotate(-10deg);
  }
  .about-candid-mark span {
    width: 28px;
    height: 118px;
    background: var(--xp-navy, #000628);
    border-radius: 30px;
    transform: skew(-18deg);
  }
  .about-candid-mark span:nth-child(2) {
    height: 150px;
  }
  .about-editor-note {
    font-size: 13px;
    line-height: 1.65;
    color: var(--xp-muted, #526075);
  }
  .about-photo-aside > .about-editor-note {
    margin-top: 20px;
  }
  .about-partners {
    background: var(--xp-pale, #e6f1ff);
  }
  .about-section-intro {
    max-width: 980px;
  }
  .about-section-label {
    margin-bottom: 25px !important;
    font-size: 14px;
    font-weight: 500;
  }
  .about-logo-slots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-block: 50px 24px;
  }
  .about-logo-slot {
    min-height: 200px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 28px;
    background: rgb(255 255 255 / 0.65);
    border-radius: 8px;
  }
  .logo-slot-icon {
    height: 34px;
    width: 34px;
    margin-bottom: 15px;
    border: 2px solid var(--xp-navy, #000628);
    opacity: 0.2;
    border-radius: 50%;
  }
  .about-logo-slot > p {
    font-size: 16px;
    font-weight: 600;
  }
  .about-logo-slot > span:last-child {
    max-width: 220px;
    margin-top: 8px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--xp-muted, #526075);
  }
  .about-capabilities {
    color: white;
    background: var(--xp-navy, #000628);
  }
  .about-capabilities .about-copy {
    color: rgb(255 255 255 / 0.68);
  }
  .about-capabilities .about-section-label {
    color: var(--xp-lime, #8bf000);
  }
  .about-capability-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 40px;
    margin-top: 68px;
  }
  .about-capability {
    position: relative;
    padding: 30px 28px 38px 0;
    border-top: 1px solid rgb(255 255 255 / 0.24);
  }
  .capability-cross {
    position: absolute;
    top: 24px;
    right: 4px;
    font-size: 25px;
    font-weight: 300;
    color: var(--xp-lime, #8bf000);
  }
  .about-capability h3 {
    max-width: 290px;
    min-height: 2.6em;
    margin: 0 0 22px;
    font-size: 23px;
    line-height: 1.3;
    letter-spacing: -0.025em;
    font-weight: 600;
  }
  .about-capability ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.64);
  }
  .about-capability li + li {
    margin-top: 7px;
  }
  .about-capability-note {
    max-width: 780px;
    margin-top: 20px !important;
    font-size: 13px;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.56);
  }
  .about-voices {
    background: var(--xp-pale-green, #e1f9c9);
  }
  .about-voice-layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: center;
  }
  .about-quote-slot {
    padding: 40px;
    border: 1px solid
      color-mix(in srgb, var(--xp-navy, #000628) 15%, transparent);
    border-radius: 8px;
  }
  .about-quote-slot > p {
    margin-block: 36px 48px;
    font-family: var(--font-display);
    font-size: clamp(25px, 2.5vw, 36px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.25;
  }
  .about-quote-attribution {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--xp-muted, #526075);
  }
  .about-quote-attribution > span {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--xp-navy, #000628) 10%, transparent);
  }
  .about-people-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 42px 22px;
    margin-top: 68px;
  }
  .about-portrait-slot {
    aspect-ratio: 4 / 5;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 8px;
    background: var(--xp-pale, #e6f1ff);
  }
  .about-person-1 .about-portrait-slot {
    background: var(--xp-pale-green, #e1f9c9);
  }
  .about-person-2 .about-portrait-slot {
    background: var(--xp-navy, #000628);
    color: white;
  }
  .about-person-3 .about-portrait-slot {
    background: var(--xp-blue, #3898ff);
  }
  .about-person-initials {
    font-family: var(--font-display);
    font-weight: 800;
    font-style: italic;
    font-size: clamp(52px, 6vw, 100px);
    letter-spacing: -0.07em;
    opacity: 0.15;
  }
  .about-portrait-status {
    position: absolute;
    bottom: 20px;
    left: 22px;
    font-family: var(--font-mono);
    font-size: 10px;
    opacity: 0.65;
  }
  .about-person h3 {
    margin: 20px 0 8px;
    font-size: 20px;
    font-weight: 600;
