---
import Layout from '@/layouts/Layout.astro';
import { brand } from '@/config/brand';
interface Props {title:string;description?:string}
const {title,description='Create a school, prepare its pages, and hand over the tools to its team.'}=Astro.props;
---
<Layout title={`${title} — XtraPoint Admin`} description={description} noindex>
 <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>
 <header class="border-b border-gray-200 bg-white"><div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-5"><a href="/admin/schools"><img src={brand.logo.navy} alt="XtraPoint" class="h-7 w-auto"/></a><nav aria-label="Administration" class="flex items-center gap-6 text-sm font-semibold"><a href="/admin/schools">Schools</a><a href="/resources/ambassador-toolkit">Ambassador Toolkit</a><a href="/portal?switch=1">Account</a></nav></div></header>
 <main id="main" class="mx-auto max-w-6xl px-6 py-10 sm:py-14"><h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{title}</h1><p class="mt-3 max-w-2xl text-base leading-relaxed text-gray-600">{description}</p><slot/></main>
</Layout>
