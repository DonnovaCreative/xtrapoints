---
// =============================================================================
// MARKETING PORTAL layout — the dashboard chrome shared by every portal page.
//
// Pages supply their body; this owns the sidebar, breadcrumbs, page heading and
// the shared XtraPoint navigation. A page therefore never has to know the token exists
// beyond passing `base` through, and can't ship without the nav.
// =============================================================================
import Layout from "@/layouts/Layout.astro";
import PortalShell from "@/components/portal/PortalShell";
import PortalInteractions from "@/components/portal/PortalInteractions.astro";
import { type School } from "@/data/schools";
import { PORTAL_NAV, navHref, navItem } from "@/lib/portalNav";
import { brand } from "@/config/brand";
import { getPortalIdentity } from "@/lib/portalAuth";
import { canAdministerPartners, canEditPartnerContent } from "@/lib/portalPermissions";

interface Props {
  school: School;
  /** `/portal/<token-or-slug>` — every in-portal link hangs off this. */
  base: string;
  /** Which nav entry is open ("" is the dashboard root). */
  active: string;
  /** Appended after the section crumb — e.g. a single resource's title. */
  crumb?: string;
  /** Overrides the section's own title/blurb (used by resource detail pages). */
  heading?: string;
  blurb?: string;
  /**
   * How the visitor got in. Account controls only make sense for "session" —
   * a legacy token link has no account to show or sign out of.
   */
  via?: "token" | "session";
  /** XtraPoint staff viewing a school that isn't their own — say so on screen. */
  staff?: boolean;
}

const { school, base, active, crumb, heading, blurb, via = "token", staff = false } = Astro.props;
const section = navItem(active);
const identity = via === "session" ? await getPortalIdentity(Astro) : undefined;
const canEdit = Boolean(identity && canEditPartnerContent(identity));
const staffAdmin = canAdministerPartners(identity);

const nav = PORTAL_NAV.map((item) => ({
  title: item.title,
  href: navHref(base, item.segment),
  icon: item.icon,
}));

const crumbs = [
  { label: school.short, href: base },
  ...(active ? [{ label: section.title, href: navHref(base, active) }] : []),
  ...(crumb ? [{ label: crumb }] : []),
];

const pageTitle = heading ?? section.title;
const pageBlurb = blurb ?? section.blurb;
---

<Layout
  title={`${crumb ?? section.title} — ${school.short} ${brand.name} Portal`}
  description={`Private marketing resources for ${school.name}.`}
  noindex
>
  <div class="font-sans">
    <PortalShell
      client:load
      nav={nav}
      activeHref={navHref(base, active)}
      crumbs={crumbs}
      product="marketing"
      marketingHref={via === "session" ? `/portal/${school.slug}` : base}
      rememberSchool={via === "session" ? school.slug : undefined}
      contextLabel={school.name}
      brandLogo={brand.logo.navy}
      brandMark={brand.logo.mark}
      brandName={brand.nameSpaced}
      supportHref={`mailto:${brand.salesEmail}?subject=${encodeURIComponent(
        `Marketing request — ${school.short}`,
      )}`}
      showAccount={via === "session"}
    >
      {
        /* Staff are looking at someone else's portal. Say whose, unmissably —
           this is the one thing that stops a support conversation going wrong,
           and it makes a screenshot unambiguous. */
        staff && (
          <div class="border-b border-amber-200 bg-amber-50 px-5 py-2.5 sm:px-8">
            <p class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-2 gap-y-1 text-xs text-amber-900">
              <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4m0 4h.01M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
              <span>
                Staff view — you're seeing <strong class="font-bold">{school.name}</strong>'s
                portal, not your own.
              </span>
              <a href={staffAdmin ? "/admin/schools" : "/portal?switch"} class="font-semibold underline underline-offset-2">
                {staffAdmin ? "School administration" : "Switch workspace"}
              </a>
            </p>
          </div>
        )
      }

      <div class="mx-auto w-full max-w-5xl px-5 pb-16 pt-8 sm:px-8">
        <header>
          <h1 class="text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl">
            {pageTitle}
          </h1>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-gray-600">{pageBlurb}</p>
          {via === "session" && (
            <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
              {canEdit && <a href={`${base}/edit`} class="rounded-full bg-ink px-4 py-2 font-semibold text-white">Edit school pages</a>}
              <a href={`${base}/preview`} class="rounded-full border border-gray-200 px-4 py-2 font-semibold text-gray-700">Preview current draft</a>
              {!canEdit && <span class="text-xs text-gray-500">Viewer access · changes are managed by your school’s editors.</span>}
            </div>
          )}
        </header>

        <slot />

        <footer class="mt-14 border-t border-gray-200 pt-6">
          <p class="text-xs leading-relaxed text-gray-500">
            {via === "session" ? (
              <>This workspace is available to authorized members of {school.name}’s team. Contact your school administrator for access changes. For marketing help, email </>
            ) : (
              <>This private link gives access to {school.name}’s resources. Share it only within your team. To replace the link or set up account access, email </>
            )}<a
              href={`mailto:${brand.salesEmail}`}
              class="font-semibold text-gray-700 hover:underline">{brand.salesEmail}</a
            >.
          </p>
        </footer>
      </div>
    </PortalShell>
  </div>

  <PortalInteractions />
</Layout>
