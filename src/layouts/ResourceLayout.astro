---
import Layout from '@/layouts/Layout.astro';
import { brand } from '@/config/brand';
import { resourceCenterIsPublic } from '@/data/toolkit/access';
import ResourceSearch from '@/components/resources/ResourceSearch';
import '@/styles/resources.css';
interface Props { title: string; description: string; crumbs?: { label: string; href?: string }[]; search?: boolean }
const { title, description, crumbs = [], search = true } = Astro.props;
const isPublic = resourceCenterIsPublic();
---
<Layout title={`${title} | ${brand.name} Resources`} description={description} noindex={!isPublic}>
  <div class="rc-site">
    <a class="rc-skip" href="#resource-main">Skip to content</a>
    <header class="rc-header"><div class="rc-header-inner"><a href="/" aria-label={`${brand.name} home`}><img src={brand.logo.navy} alt={brand.name} width="150" height="32" /></a><nav aria-label="Resource Center"><a href="/resources" aria-current="page">Resource Center</a><a href="/portal">Partner portal</a></nav></div></header>
    {!isPublic && <div class="rc-preview-banner">Private partner resources · Program planning edition.</div>}
    <div class="rc-container">
      <div class="rc-page-top"><nav aria-label="Breadcrumb" class="rc-breadcrumb"><ol><li><a href="/resources">Resources</a></li>{crumbs.map(crumb => <li>{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}</li>)}</ol></nav>{search && <ResourceSearch client:load compact />}</div>
      <main id="resource-main"><slot /></main>
      <footer class="rc-footer"><div><img src={brand.logo.navy} alt={brand.name} width="118" height="28" /><p>Your organization owns and operates its ambassador program. XtraPoint provides technology, templates and agreed support.</p></div><p>Toolkit 1.2 · September 11, 2026<br /><a href={`mailto:${brand.salesEmail}`}>Get help from XtraPoint</a></p></footer>
    </div>
  </div>
</Layout>
