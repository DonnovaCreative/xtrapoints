---
import Layout from '@/layouts/Layout.astro';
import PortalShell from '@/components/portal/PortalShell';
import { brand } from '@/config/brand';
import { resourceCenterIsPublic } from '@/data/toolkit/access';
import { toolkitBase, toolkit as bundledToolkit } from '@/data/toolkit';
import type { PortalIcon } from '@/lib/portalNav';
import ResourceSearch from '@/components/resources/ResourceSearch';
import '@/styles/resources.css';
interface Props { title: string; description: string; crumbs?: { label: string; href?: string }[]; search?: boolean; publication?: typeof bundledToolkit }
const { title, description, crumbs = [], search = true, publication = bundledToolkit } = Astro.props;
const isPublic = resourceCenterIsPublic();
const standalone = import.meta.env.XP_TOOLKIT_STANDALONE === 'true';
const marketingHref = standalone ? 'https://www.xtrapoint.com/portal' : '/portal';
const nav = [
  { title: 'Overview', href: toolkitBase, icon: 'home' as PortalIcon },
  ...publication.resources.map(resource => ({ title: resource.title, href: resource.href, icon: resource.id as PortalIcon })),
];
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const activeHref = nav.find(item => item.href !== toolkitBase && (currentPath === item.href || currentPath.startsWith(item.href + '/')))?.href ?? toolkitBase;
const shellCrumbs = crumbs.length ? crumbs : [{ label: 'Ambassador Toolkit' }];
---
<Layout title={`${title} | ${brand.name}`} description={description} noindex={!isPublic}>
  <PortalShell client:load product="toolkit" marketingHref={marketingHref} nav={nav} activeHref={activeHref} crumbs={shellCrumbs} brandLogo={brand.logo.navy} brandMark={brand.logo.mark} brandName={brand.nameSpaced} supportHref={`mailto:${brand.salesEmail}`} showAccount={!standalone && !isPublic} contextLabel="Shared partner guidance">
    <div class="rc-site rc-workspace">
      <a class="rc-skip" href="#resource-main">Skip to content</a>
      {!isPublic && <div class="rc-preview-banner">{standalone ? 'Private toolkit review' : 'Private partner toolkit'} · Guidance, templates and downloads for authorized partners.</div>}
      <div class="rc-container">
        {search && <div class="rc-page-top"><ResourceSearch client:load compact /></div>}
        <div id="resource-main" tabindex="-1"><slot /></div>
        <footer class="rc-footer"><div><img src={brand.logo.navy} alt={brand.name} width="118" height="28" /><p>Your organization owns and operates its ambassador program. XtraPoint provides technology, templates and agreed support.</p></div><p>Toolkit {publication.release.version}<br /><a href={`mailto:${brand.salesEmail}`}>Get help from XtraPoint</a></p></footer>
      </div>
    </div>
  </PortalShell>
</Layout>
