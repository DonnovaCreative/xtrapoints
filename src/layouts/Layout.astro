---
import "@/styles/globals.css";
import { brand } from "@/config/brand";
import { isProduction, shouldNoindex } from "@/config/site-env";

export interface Props {
  title: string;
  description: string;
  /** Path-relative OG image in /public, defaults to the brand OG card. */
  ogImage?: string;
  /** Force noindex on this page regardless of environment (e.g. sales collateral). */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = "/assets/og-image-xp.jpg",
  noindex = false,
} = Astro.props;

// HubSpot tracking — PRODUCTION ONLY, and that is a consent decision, not a
// tidiness one. The script sets `hubspotutk`, a non-essential analytics cookie,
// so it may only run where a cookie banner can gate it. Banners are configured
// in HubSpot for xtrapoint.com and www.xtrapoint.com — NOT for staging — so
// loading it on staging would set a tracking cookie with no way to decline.
// Keeping it off preview/local also stops our own QA traffic polluting HubSpot
// analytics. See src/config/site-env.ts for how production is identified.
const hubspotPortalId = import.meta.env.PUBLIC_HUBSPOT_PORTAL_ID;
const loadHubSpot = isProduction && Boolean(hubspotPortalId);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Flag JS early so scroll-reveal base state only hides when JS can restore it. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Non-production (staging / preview) builds only — keeps them out of search.
        Production (VERCEL_ENV="production") never renders this. */}
    {(shouldNoindex || noindex) && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.nameSpaced} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts: display=swap so text paints immediately on the brand stack -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Permanent+Marker&family=Space+Mono:wght@400;700&display=swap"
    />

    {/* HubSpot tracking + cookie banner. Loads the banner too, so consent is
        handled by HubSpot rather than a second banner of our own. */}
    {loadHubSpot && (
      <script
        type="text/javascript"
        id="hs-script-loader"
        async
        defer
        src={`https://js-na2.hs-scripts.com/${hubspotPortalId}.js`}
      />
    )}
  </head>
  <body>
    <slot />

    <!-- Scroll-reveal: add .is-visible to reveal/stagger elements as they enter. -->
    <script is:inline>
      (() => {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const els = document.querySelectorAll(
          ".reveal, .reveal-left, .reveal-right, .stagger",
        );
        if (reduce || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                obs.unobserve(e.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
