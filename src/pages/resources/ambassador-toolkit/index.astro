---
export const prerender = false;
import ResourceLayout from '@/layouts/ResourceLayout.astro';
import ToolkitOverview from '@/components/resources/ToolkitOverview.astro';
import { gateResourceCenter } from '@/data/toolkit/access';
import { getToolkitPublication } from '@/data/toolkitCms';
const denied = await gateResourceCenter(Astro); if (denied) return denied;
const { toolkit } = await getToolkitPublication();
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<ResourceLayout publication={toolkit} title="Ambassador Toolkit" description="Six connected resources to help your organization design, launch and operate its ambassador program." crumbs={[{ label: 'Ambassador Toolkit' }]} search={false}><ToolkitOverview publication={toolkit} /></ResourceLayout>
