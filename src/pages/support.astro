---
// Customer Support page (/support). Footer-linked. Content is CMS-managed via the
// `supportPage` singleton in Sanity (Legal & Compliance → Customer Support), but
// this page keeps its own bespoke layout (structured contact card + numbered
// sections with a sticky TOC) — it does NOT use the shared legal template.
//
// Structured fields (email / hours / address) render the contact card; the `body`
// rich text renders the sections below it, reusing renderLegalBody so headings
// become the table-of-contents (contact card is section 01, body H2s continue).
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { brand } from "@/config/brand";
import { getSupportPage } from "@/data/supportSource";
import { renderLegalBody } from "@/data/legal";

const page = (await getSupportPage()) ?? {
  title: "Customer Support",
  intro: "",
  email: "",
  hours: "",
  address: "",
  body: [],
};

const { html, toc: bodyToc } = renderLegalBody(page.body);

// Contact card is section 01; the body's H2s continue from 02. Number the
// top-level (H2) entries so the sidebar outline mirrors the body's CSS counter.
const toc = [
  { id: "contact", text: "Contact us", level: 2 as const },
  ...bodyToc,
];
let h2n = 0;
const tocItems = toc.map((t) => ({
  ...t,
  num: t.level === 2 ? String(++h2n).padStart(2, "0") : null,
}));

const addressLines = page.address.split("\n").map((l) => l.trim()).filter(Boolean);

const title = `${page.title} · ${brand.name}`;
const description =
  page.intro ||
  `Get help from ${brand.nameSpaced} with questions about your account, payments, and refunds.`;
---

<Layout title={title} description={description}>
  <Header variant="light" />
  <main class="bg-white">
    <!-- page header — restrained, light, editorial -->
    <div class="border-b border-gray-100">
      <div
        class="mx-auto max-w-7xl px-6 pb-10 pt-[calc(var(--header-h)+3rem)] lg:px-10 lg:pb-14 lg:pt-[calc(var(--header-h)+4rem)]"
      >
        <p
          class="sp-fade flex items-center gap-2.5 font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-gray-400"
        >
          <span class="inline-block h-2 w-2 bg-lime" aria-hidden="true"></span>
          Support
        </p>
        <h1
          class="sp-fade mt-5 max-w-3xl text-[clamp(2rem,4.5vw,3.25rem)] font-bold leading-[1.05] tracking-tight text-ink"
          style="animation-delay:60ms"
        >
          {page.title}
        </h1>
        {page.intro && (
          <p
            class="sp-fade mt-4 max-w-2xl text-lg leading-relaxed text-gray-600"
            style="animation-delay:120ms"
          >
            {page.intro}
          </p>
        )}
      </div>
    </div>

    <!-- body -->
    <div
      class="mx-auto grid max-w-7xl gap-y-10 px-6 py-12 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-x-20 lg:px-10 lg:py-16"
    >
      <!-- sticky sidebar: on-this-page -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <nav aria-label="On this page">
            <p
              class="font-mono text-[0.625rem] uppercase tracking-[0.16em] text-gray-400"
            >
              On this page
            </p>
            <ul class="mt-3.5 flex flex-col">
              {
                tocItems.map((t) => (
                  <li>
                    <a
                      href={`#${t.id}`}
                      data-toc-link
                      class:list={[
                        "toc-link group flex gap-2.5 py-1.5 text-sm leading-snug text-gray-500 transition-colors hover:text-ink",
                        t.level === 3 && "pl-[2.375rem] text-[0.8125rem]",
                      ]}
                    >
                      {t.num && (
                        <span class="toc-num font-mono text-[0.6875rem] tabular-nums leading-5 text-gray-300 transition-colors">
                          {t.num}
                        </span>
                      )}
                      <span>{t.text}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </aside>

      <!-- article -->
      <article class="support-body min-w-0 max-w-[42rem]">
        <!-- 01 · Contact us (structured card) -->
        <h2 id="contact">Contact us</h2>
        <dl class="contact-card">
          {page.email && (
            <div>
              <dt>Email</dt>
              <dd>
                <a href={`mailto:${page.email}`}>{page.email}</a>
              </dd>
            </div>
          )}
          {page.hours && (
            <div>
              <dt>Hours</dt>
              <dd>{page.hours}</dd>
            </div>
          )}
          {addressLines.length > 0 && (
            <div>
              <dt>Mailing address</dt>
              <dd>
                {addressLines.map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line}
                  </>
                ))}
              </dd>
            </div>
          )}
        </dl>

        <!-- 02+ · sections (CMS rich text) -->
        <Fragment set:html={html} />
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* Gentle, calm entrance for the header (guarded for reduced motion). */
  @media (prefers-reduced-motion: no-preference) {
    .sp-fade {
      animation: spFade 0.5s cubic-bezier(0.2, 0.6, 0.2, 1) both;
    }
  }
  @keyframes spFade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Active states for the TOC scrollspy. */
  .toc-link.is-active {
    color: var(--color-ink);
    font-weight: 500;
  }
  .toc-link.is-active .toc-num {
    color: var(--color-lime-dark);
  }

  /* --- Article prose — quiet + editorial, tuned to brand tokens (mirrors the
     legal pages so /support and /terms read as one family). The selectors target
     both the template heading (Contact us) and the injected body headings. --- */
  .support-body {
    counter-reset: support-section;
    color: var(--color-gray-600);
    font-size: 1rem;
    line-height: 1.75;
  }
  .support-body :global(p) {
    margin: 1.05rem 0;
  }
  .support-body h2,
  .support-body :global(h2) {
    counter-increment: support-section;
    scroll-margin-top: 6rem;
    margin-top: 3.25rem;
    color: var(--color-ink);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .support-body h2:first-child {
    margin-top: 0;
  }
  /* Numbered mono kicker above each section — mirrors the sidebar outline. */
  .support-body h2::before,
  .support-body :global(h2)::before {
    content: counter(support-section, decimal-leading-zero);
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--color-lime-dark);
  }
  .support-body :global(h3) {
    scroll-margin-top: 6rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--color-ink);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .support-body :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-gray-300);
    text-underline-offset: 3px;
    transition:
      color 0.15s ease,
      text-decoration-color 0.15s ease;
  }
  .support-body :global(a:hover) {
    color: var(--color-lime-dark);
    text-decoration-color: var(--color-lime);
  }
  .support-body :global(strong) {
    color: var(--color-gray-800);
    font-weight: 600;
  }
  .support-body :global(ul),
  .support-body :global(ol) {
    margin: 1.1rem 0;
    padding-left: 1.4rem;
  }
  .support-body :global(ul) {
    list-style: none;
  }
  .support-body :global(ol) {
    list-style: decimal;
  }
  .support-body :global(li) {
    margin: 0.4rem 0;
    padding-left: 0.4rem;
  }
  .support-body :global(ul > li) {
    position: relative;
  }
  .support-body :global(ul > li)::before {
    content: "";
    position: absolute;
    left: -0.9rem;
    top: 0.7em;
    height: 0.375rem;
    width: 0.375rem;
    background: var(--color-lime);
  }

  /* Contact block — a quiet card, structured as a definition list. */
  .contact-card {
    margin-top: 1.5rem;
    display: grid;
    gap: 1.25rem;
    border: 1px solid var(--color-gray-200);
    border-left: 3px solid var(--color-lime);
    border-radius: 0.5rem;
    background: var(--color-gray-50);
    padding: 1.5rem 1.75rem;
  }
  .contact-card dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-gray-400);
  }
  .contact-card dd {
    margin-top: 0.35rem;
    color: var(--color-gray-700);
    line-height: 1.6;
  }
  .contact-card dd a {
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-gray-300);
    text-underline-offset: 3px;
    transition:
      color 0.15s ease,
      text-decoration-color 0.15s ease;
  }
  .contact-card dd a:hover {
    color: var(--color-lime-dark);
    text-decoration-color: var(--color-lime);
  }
</style>

<!-- Scrollspy + smooth anchor scroll (same pattern as the legal pages). No JS =
     plain anchor links that still work; base content is never hidden. -->
<script is:inline>
  (() => {
    const links = Array.from(document.querySelectorAll("[data-toc-link]"));
    if (!links.length) return;
    const linkById = new Map(
      links.map((l) => [decodeURIComponent(l.hash.slice(1)), l]),
    );
    const headings = Array.from(
      document.querySelectorAll(".support-body h2"),
    ).filter((h) => h.id && linkById.has(h.id));
    if (!headings.length) return;

    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let current = null;
    const setActive = (id) => {
      if (id === current) return;
      current = id;
      links.forEach((l) => l.classList.remove("is-active"));
      linkById.get(id)?.classList.add("is-active");
    };

    // Smooth-scroll on click; keep the URL hash in sync.
    linkById.forEach((link, id) => {
      link.addEventListener("click", (e) => {
        const el = document.getElementById(id);
        if (!el) return;
        e.preventDefault();
        history.replaceState(null, "", `#${id}`);
        el.scrollIntoView({
          behavior: reduce ? "auto" : "smooth",
          block: "start",
        });
        setActive(id);
      });
    });

    // Highlight the section you're currently reading: the last heading whose top
    // has scrolled past a line near the top of the viewport. rAF-throttled.
    const LINE = 120; // px from the top of the viewport
    let ticking = false;
    const update = () => {
      ticking = false;
      let activeId = headings[0].id;
      for (const h of headings) {
        if (h.getBoundingClientRect().top - LINE <= 0) activeId = h.id;
        else break;
      }
      setActive(activeId);
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  })();
</script>
