---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
import BrandEditor from '@/components/portal/BrandEditor';
import SchoolAdminNav from '@/components/portal/SchoolAdminNav.astro';
import PrepareSchoolBrand from '@/components/portal/PrepareSchoolBrand';
import {gateAdmin} from '@/lib/adminGate';
import {canonicalPartnerId} from '@/lib/schoolManagement';
import {findPortalPartner} from '@/lib/portalAuth';
import {getSchoolDraftById} from '@/data/schoolsSource';
import {schoolEditor} from '@/data/schoolManagementStore';
import {EDITABLE_IMAGES,EDITABLE_COLORS,CREDITABLE_IMAGES,ALLOWED_IMAGE_TYPES,imageTypeLabel} from '@/lib/portalEdit';
const denied=await gateAdmin(Astro);if(denied)return denied;
let partnerId;try{partnerId=canonicalPartnerId(Astro.params.partnerId);}catch{return new Response('School not found.',{status:404});}
let school,partner;
try{[school,partner]=await Promise.all([getSchoolDraftById(partnerId),findPortalPartner({partnerId})]);}
catch{return new Response('The brand kit is temporarily unavailable. Please try again.',{status:503});}
if(!school)return new Response('School not found.',{status:404});
const base=`/admin/schools/${encodeURIComponent(partnerId)}`;
const images=Object.entries(EDITABLE_IMAGES).map(([key,v])=>({key,label:v.label,note:v.note}));
const colors=Object.entries(EDITABLE_COLORS).map(([key,v])=>({key,label:v.label,note:v.note}));
let retainedRevision;
if(!partner){
  try{retainedRevision=(await schoolEditor(partnerId)).revision;}
  catch{return new Response('The school is temporarily unavailable. Please try again.',{status:503});}
}
const justCreated=Astro.url.searchParams.get('created')==='1';
---
<AdminLayout title={`${school.short||school.name}: logos & imagery`} description="Upload and replace this school's logos and photos, and choose its brand colors. Everything here belongs to the same school draft as its page details.">
  <a href="/admin/schools" class="mt-6 inline-block text-sm font-semibold underline">All schools</a>
  <SchoolAdminNav partnerId={partnerId} active="brand" />
  {justCreated && <div class="mt-6 rounded-xl border border-lime/40 bg-lime/10 p-5"><h2 class="font-semibold text-ink">School created. Add its branding.</h2><p class="mt-1 text-sm leading-relaxed text-gray-700">Start with a header logo and square logo, then add available photos. You can return to any of these later.</p><a href={base} class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-ink underline">Continue to school details</a></div>}
  {partner ? <BrandEditor client:load partnerId={partnerId} completionHref={base} creditable={CREDITABLE_IMAGES} images={images} colors={colors} accept={ALLOWED_IMAGE_TYPES.join(',')} acceptLabel={imageTypeLabel}/> : <PrepareSchoolBrand client:load partnerId={partnerId} revision={retainedRevision!} />}
</AdminLayout>
