---
// /portal/account — who you're signed in as, and the way out.
//
// Routing note: this is a static segment, so Astro matches it ahead of the
// dynamic /portal/[school] sibling. A school whose slug were literally "account"
// would be shadowed by this page — no real school slug looks like that, but if
// one ever did, this is where the collision would be.
export const prerender = false;

import AuthLayout from "@/layouts/AuthLayout.astro";
import { SignOutButton } from "@clerk/astro/components";
import { getPortalIdentity } from "@/lib/portalAuth";
import { getSchool } from "@/data/schoolsSource";
import { brand } from "@/config/brand";

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Referrer-Policy", "no-referrer");

const identity = await getPortalIdentity(Astro);
if (!identity) return Astro.redirect("/sign-in");

const user = await Astro.locals.currentUser();
const school = identity.schoolSlug ? await getSchool(identity.schoolSlug) : undefined;

const email = user?.primaryEmailAddress?.emailAddress;
const name = [user?.firstName, user?.lastName].filter(Boolean).join(" ") || email;

const rows = [
  name && { label: "Signed in as", value: name },
  email && name !== email && { label: "Email", value: email },
  school && { label: "School", value: school.name },
].filter(Boolean) as { label: string; value: string }[];
---

<AuthLayout
  title="Your account"
  heading="Your account"
  blurb="Access to this portal comes from your school's team. To add or remove someone, get in touch."
>
  <div class="w-full max-w-sm">
    <dl class="rounded-card border border-gray-200 bg-white p-5">
      {
        rows.map((row) => (
          <div class="flex justify-between gap-4 border-b border-gray-100 py-2.5 text-sm first:pt-0 last:border-0 last:pb-0">
            <dt class="shrink-0 text-gray-500">{row.label}</dt>
            <dd class="min-w-0 truncate text-right font-medium text-gray-900">{row.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-5 flex flex-col items-center gap-3">
      {
        school && (
          <a
            href={`/portal/${school.slug}`}
            class="inline-flex w-full items-center justify-center rounded-full bg-lime px-5 py-2.5 text-sm font-semibold text-on-accent transition-colors hover:bg-lime-deep"
          >
            Back to your portal
          </a>
        )
      }
      <a href="/portal?switch=1" class="text-sm font-semibold text-gray-500 transition-colors hover:text-gray-900">
        Switch school
      </a>
      {/* asChild — see the note in src/pages/portal/index.astro. */}
      <SignOutButton asChild redirectUrl="/sign-in">
        <button
          type="button"
          class="text-sm font-semibold text-gray-500 transition-colors hover:text-gray-900"
        >
          Sign out
        </button>
      </SignOutButton>
      <a
        href={`mailto:${brand.salesEmail}?subject=${encodeURIComponent("Portal access")}`}
        class="text-xs text-gray-400 hover:text-gray-600"
      >
        Add or remove someone
      </a>
    </div>
  </div>
</AuthLayout>
