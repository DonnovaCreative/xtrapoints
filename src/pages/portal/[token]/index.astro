---
// MARKETING PORTAL — the dashboard's front door, /portal/<token>.
//
// This is the only route that renders a switched-off school (gatePortal's
// `allowDisabled`); every other page redirects here, so the "not active" notice
// is written and maintained once.
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import PortalLayout from "@/layouts/PortalLayout.astro";
import { gatePortal } from "@/lib/portalRoute";
import { getResources } from "@/data/resourcesSource";
import { PORTAL_NAV, navHref } from "@/lib/portalNav";
import { brand } from "@/config/brand";

const gate = await gatePortal(Astro, { allowDisabled: true });
if (!gate.ok) return gate.response;
const { school, base, enabled } = gate;

// Only used for the "N templates" count on the library card — a library outage
// shouldn't take the dashboard down with it.
let resourceCount = 0;
if (enabled) {
  try {
    resourceCount = (await getResources()).length;
  } catch (err) {
    console.error("resource library fetch failed:", err);
  }
}

const sections = PORTAL_NAV.filter((i) => i.segment).map((item) => ({
  ...item,
  href: navHref(base, item.segment),
  meta:
    item.segment === "resources"
      ? resourceCount > 0
        ? `${resourceCount} ${resourceCount === 1 ? "template" : "templates"}`
        : undefined
      : item.segment === "pages"
        ? "2 live pages"
        : undefined,
}));

const ICON_PATHS: Record<string, string> = {
  pages: "M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM3 9h18",
  onePager: "M12 3v12m0 0l-4-4m4 4l4-4M4 21h16",
  library: "M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM3 16l5-5 4 4 3-3 6 6",
  brand: "M12 3a9 9 0 1 0 0 18h1.5a2.5 2.5 0 0 0 0-5H13a2 2 0 0 1 0-4h4a4 4 0 0 0 4-4 5 5 0 0 0-5-5zM7.5 11.5h.01M10 7.5h.01M14.5 7h.01",
};
---

{
  enabled ? (
    <PortalLayout
      school={school}
      base={base}
      active=""
      heading={`Welcome, ${school.short}.`}
      blurb={`Everything ${brand.name} has built for ${school.fund} — your live pages, your co-branded sell sheet, the template library, and your brand files. Bookmark this page; it stays up to date on its own as we add to your program.`}
    >
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {sections.map((section) => (
          <a
            href={section.href}
            class="group flex flex-col rounded-card border border-gray-200 bg-white p-5 transition-colors hover:border-gray-300 hover:bg-gray-50/60"
          >
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-lime-soft text-lime-dark">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={ICON_PATHS[section.icon]} />
              </svg>
            </span>
            <h2 class="mt-4 text-base font-bold text-gray-900">{section.title}</h2>
            <p class="mt-1.5 flex-1 text-sm leading-relaxed text-gray-600">{section.blurb}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-gray-900">
              {section.meta ?? "Open"}
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
            </span>
          </a>
        ))}
      </div>

      <section class="mt-10 rounded-card bg-ink px-6 py-8 sm:px-8">
        <h2 class="text-xl font-extrabold tracking-tight text-white">
          Need something that isn't here?
        </h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-white/70">
          Flyers, social graphics, signage, campaign ideas — tell us what you're
          planning and the {brand.name} marketing team will put it together with you.
        </p>
        <a
          href={`mailto:${brand.salesEmail}?subject=${encodeURIComponent(`Marketing request — ${school.short}`)}`}
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-lime px-5 py-2.5 text-sm font-semibold text-on-accent transition-colors hover:bg-lime-deep"
        >
          Email the marketing team
        </a>
      </section>
    </PortalLayout>
  ) : (
    <Layout
      title={`${school.short} — ${brand.name} Marketing Portal`}
      description="This portal is not currently active."
      noindex
    >
      <main class="flex min-h-screen items-center justify-center bg-gray-50 px-6 font-sans">
        <div class="w-full max-w-md rounded-card border border-gray-200 bg-white p-8 text-center">
          <img src={brand.logo.navy} alt={brand.nameSpaced} class="mx-auto h-7 w-auto" />
          <h1 class="mt-6 text-xl font-extrabold tracking-tight text-gray-900">
            This portal isn't active
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-gray-600">
            The marketing portal for {school.name} has been turned off. If you
            think this is a mistake, get in touch and we'll sort it out.
          </p>
          <a
            href={`mailto:${brand.salesEmail}?subject=${encodeURIComponent(
              `Portal access — ${school.short}`,
            )}`}
            class="mt-6 inline-flex items-center rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90"
          >
            Contact {brand.name}
          </a>
        </div>
      </main>
    </Layout>
  )
}
