---
export const prerender = false;
import AuthLayout from "@/layouts/AuthLayout.astro";
import { OrganizationList, SignOutButton } from "@clerk/astro/components";
import { getPortalIdentity } from "@/lib/portalAuth";
import { canAdministerPartners } from "@/lib/portalPermissions";
import { getSchoolPortalBySlug } from "@/data/schoolsSource";
import { brand } from "@/config/brand";

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
let identity;
try { identity = await getPortalIdentity(Astro); }
catch { return new Response("Account verification is temporarily unavailable. Please try again.", { status: 503 }); }
if (!identity) return Astro.redirect("/sign-in");
const switching = Astro.url.searchParams.has("switch");
if (canAdministerPartners(identity) && !switching) return Astro.redirect("/admin/schools");
// Onboarding is independent of public page publication. The dashboard itself
// explains disabled access; a prepared partner must not be rejected as not live.
if (identity.schoolSlug && !switching) {
  try {
    const portal = await getSchoolPortalBySlug(identity.schoolSlug);
    if (portal) return Astro.redirect(`/portal/${encodeURIComponent(portal.school.slug)}`);
  } catch { return new Response("Your workspace is temporarily unavailable. Please try again.", { status: 503 }); }
}
let memberships = 0;
try {
  const { clerkClient } = await import("@clerk/astro/server");
  const list = await clerkClient(Astro).users.getOrganizationMembershipList({ userId: identity.userId });
  memberships = list.totalCount ?? list.data.length;
} catch { return new Response("Workspace selection is temporarily unavailable. Please try again.", { status: 503 }); }
const needsToPick = memberships > 0;
const heading = needsToPick ? "Choose your workspace" : "Your workspace is being prepared";
const blurb = needsToPick
  ? "Choose your school or XtraPoint team to continue."
  : "Your account is ready. Your XtraPoint contact can connect it to your school's workspace.";
---
<AuthLayout title="Partner portal" heading={heading} blurb={blurb}>
  <div class="flex w-full flex-col items-center gap-5">
    {identity.isStaff && !canAdministerPartners(identity) && <p class="max-w-md rounded-lg bg-gray-50 p-4 text-sm text-gray-600">School administration requires an XtraPoint staff administrator role. You can still open the shared Resource Center.</p>}
    {needsToPick ? <OrganizationList hidePersonal skipInvitationScreen afterSelectOrganizationUrl="/portal" afterCreateOrganizationUrl="/portal" /> : <a href={`mailto:${brand.salesEmail}?subject=${encodeURIComponent("Portal access")}`} class="inline-flex items-center rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-white">Contact {brand.name}</a>}
    <a href="/resources/ambassador-toolkit" class="text-sm font-semibold text-ink underline">Open the Ambassador Toolkit</a>
    <SignOutButton asChild redirectUrl="/sign-in"><button type="button" class="text-sm font-semibold text-gray-500 hover:text-gray-900">Sign out</button></SignOutButton>
  </div>
</AuthLayout>
