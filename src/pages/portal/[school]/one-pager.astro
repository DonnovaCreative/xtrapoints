---
// MARKETING PORTAL → Sales one-pager. Its own section rather than a library
// entry: every school gets one automatically, with no setup and nothing for us
// to upload, so it's guaranteed to be here in a way library content isn't.
export const prerender = false;

import PortalLayout from "@/layouts/PortalLayout.astro";
import { gatePortal } from "@/lib/portalRoute";
import { brand } from "@/config/brand";

const gate = await gatePortal(Astro);
if (!gate.ok) return gate.response;
const { school, base, via, staff } = gate;

const viewUrl = `/schools/${school.slug}/one-pager`;
const pdfUrl = `/schools/${school.slug}/one-pager.pdf`;
// Rendered from the one-pager page itself, so it always shows this school's
// actual sheet rather than a stock mock (see one-pager.png.ts).
const imgUrl = `/schools/${school.slug}/one-pager.png`;
const title = `${school.short} × ${brand.name} one-pager`;
---

<PortalLayout school={school} base={base} active="one-pager" via={via} staff={staff}>
  <div
    class="mt-8 flex flex-col gap-6 rounded-card border border-gray-200 bg-white p-5 sm:flex-row sm:p-6"
  >
    <a
      href={imgUrl}
      target="_blank"
      rel="noopener"
      data-lightbox={imgUrl}
      data-lightbox-title={title}
      class="group relative block w-40 shrink-0 overflow-hidden rounded-lg border border-gray-200 bg-gray-50 sm:w-56"
    >
      <img
        src={imgUrl}
        alt={`The ${school.short} sales one-pager`}
        loading="lazy"
        class="aspect-[8.5/11] w-full object-cover object-top"
      />
      <span
        class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/0 opacity-0 transition duration-200 group-hover:bg-black/35 group-hover:opacity-100 group-focus-visible:bg-black/35 group-focus-visible:opacity-100"
      >
        <svg class="h-8 w-8 text-white drop-shadow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M11 8v6M8 11h6"/></svg>
      </span>
    </a>

    <div class="min-w-0 flex-1">
      <h2 class="text-base font-bold text-gray-900">{title}</h2>
      <p class="mt-1.5 text-sm leading-relaxed text-gray-600">
        Print-ready PDF, US Letter, one page. It's built from your school
        document — your logo, your colors, your fund name — so it rebuilds itself
        whenever those change. Click the preview to see it full size.
      </p>

      <dl class="mt-5 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
        <div>
          <dt class="font-mono text-[0.6875rem] uppercase tracking-wider text-gray-400">Format</dt>
          <dd class="mt-0.5 text-gray-700">PDF · US Letter (8.5 × 11 in)</dd>
        </div>
        <div>
          <dt class="font-mono text-[0.6875rem] uppercase tracking-wider text-gray-400">Best for</dt>
          <dd class="mt-0.5 text-gray-700">Board decks, sponsor meetings, print handouts</dd>
        </div>
      </dl>

      <div class="mt-6 flex flex-wrap items-center gap-2">
        <a
          href={pdfUrl}
          class="inline-flex items-center gap-1.5 rounded-full bg-lime px-4 py-2 text-sm font-semibold text-on-accent transition-colors hover:bg-lime-deep"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
          Download PDF
        </a>
        <a
          href={viewUrl}
          class="inline-flex items-center rounded-full border border-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50"
        >
          Open as page
        </a>
      </div>
    </div>
  </div>
</PortalLayout>
