---
// MARKETING PORTAL → Brand kit. The school's own logo files and color values,
// read straight off the school document — the same source the public pages use,
// so what a school copies from here is exactly what we render with.
export const prerender = false;

import PortalLayout from "@/layouts/PortalLayout.astro";
import { gatePortal } from "@/lib/portalRoute";

const gate = await gatePortal(Astro);
if (!gate.ok) return gate.response;
const { school, base, via, staff } = gate;
const t = school.theme;

// Sanity's asset CDN takes ?dl=<filename> to force a download (and name the
// file) instead of opening the image in the tab.
const fileBase = school.short.replace(/[^\w-]+/g, "-");
const download = (url: string, label: string) => {
  const ext = url.split("?")[0].split(".").pop() ?? "png";
  return `${url}?dl=${fileBase}-${label}.${ext}`;
};

const logos = [
  school.logo && {
    url: school.logo,
    label: "logo",
    title: "Header logo",
    note: "White / mono — for dark backgrounds",
  },
  school.avatar && {
    url: school.avatar,
    label: "avatar",
    title: "App avatar",
    note: "Full-color square mark",
  },
  school.mark && {
    url: school.mark,
    label: "mark",
    title: "App mark",
    note: "Single-color icon",
  },
].filter(Boolean) as { url: string; label: string; title: string; note: string }[];

const swatches = [
  { name: "Primary", hex: t.primary },
  ...(t.hasSecondary ? [{ name: "Secondary", hex: t.secondary }] : []),
  { name: "Dark", hex: t.ink },
];
---

<PortalLayout school={school} base={base} active="brand" via={via} staff={staff}>
  {
    logos.length > 0 && (
      <section class="mt-8">
        <h2 class="text-sm font-bold text-gray-900">Logo files</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          {logos.map((logo) => (
            <div class="rounded-card border border-gray-200 bg-white p-5">
              <div class="flex h-20 items-center justify-center rounded-lg bg-ink p-3">
                <img src={logo.url} alt={logo.title} class="max-h-full max-w-full object-contain" />
              </div>
              <h3 class="mt-4 text-sm font-bold text-gray-900">{logo.title}</h3>
              <p class="mt-1 text-xs leading-relaxed text-gray-500">{logo.note}</p>
              <a
                href={download(logo.url, logo.label)}
                class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-lime-dark hover:underline"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
                Download
              </a>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="mt-8">
    <h2 class="text-sm font-bold text-gray-900">Colors</h2>
    <p class="mt-1 text-sm text-gray-500">Click a swatch to copy its hex value.</p>
    <div class="mt-4 rounded-card border border-gray-200 bg-white p-5">
      <div class="flex flex-wrap gap-3">
        {
          swatches.map((s) => (
            <button
              type="button"
              data-copy={s.hex}
              class="flex items-center gap-3 rounded-full border border-gray-200 py-1.5 pl-1.5 pr-4 text-left transition-colors hover:bg-gray-50"
              title={`Copy ${s.hex}`}
            >
              <span
                class="h-8 w-8 shrink-0 rounded-full border border-black/10"
                style={`background:${s.hex}`}
                aria-hidden="true"
              />
              <span>
                <span data-copy-label class="block text-xs font-semibold text-gray-900">
                  {s.name}
                </span>
                <span class="block font-mono text-xs uppercase text-gray-500">{s.hex}</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </section>
</PortalLayout>
