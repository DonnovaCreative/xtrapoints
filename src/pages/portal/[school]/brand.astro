---
// MARKETING PORTAL → Brand kit.
//
// Two halves: the school EDITS their brand here (logos, colors, photos — written
// to the Sanity draft, reviewed by XtraPoint before it reaches their pages), and
// below that they can DOWNLOAD the files we're currently using, which is what
// this page was before editing existed and is still what they need when making
// something themselves.
export const prerender = false;

import PortalLayout from "@/layouts/PortalLayout.astro";
import BrandEditor from "@/components/portal/BrandEditor";
import { gatePortal } from "@/lib/portalRoute";
import {
  EDITABLE_COLORS,
  EDITABLE_IMAGES,
  CREDITABLE_IMAGES,
  ALLOWED_IMAGE_TYPES,
  imageTypeLabel,
} from "@/lib/portalEdit";

const gate = await gatePortal(Astro);
if (!gate.ok) return gate.response;
const { school, base, via, staff } = gate;
const t = school.theme;

// Sanity's asset CDN takes ?dl=<filename> to force a download (and name the
// file) instead of opening the image in the tab.
const fileBase = school.short.replace(/[^\w-]+/g, "-");
const download = (url: string, label: string) => {
  const ext = url.split("?")[0].split(".").pop() ?? "png";
  return `${url}?dl=${fileBase}-${label}.${ext}`;
};

const logos = [
  school.logo && { url: school.logo, label: "logo", title: "Header logo" },
  school.avatar && { url: school.avatar, label: "avatar", title: "App avatar" },
].filter(Boolean) as { url: string; label: string; title: string }[];

const swatches = [
  { name: "Primary", hex: t.primary },
  ...(t.hasSecondary ? [{ name: "Secondary", hex: t.secondary }] : []),
  { name: "Dark", hex: t.ink },
];

// Shapes for the editor island — plain data, since it crosses into React.
const images = Object.entries(EDITABLE_IMAGES).map(([key, v]) => ({
  key,
  label: v.label,
  note: v.note,
}));
const colors = Object.entries(EDITABLE_COLORS).map(([key, v]) => ({
  key,
  label: v.label,
  note: v.note,
}));

// A token visitor has no account, so there's nobody to attribute edits to —
// they get the read-only view the portal had before. Staff edit in the Studio.
const canEdit = via === "session" && !staff;
---

<PortalLayout
  school={school}
  base={base}
  active="brand"
  via={via}
  staff={staff}
  blurb="Your logo, colors and photos — change them here, and we'll review before anything reaches your live pages."
>
  {
    canEdit ? (
      <BrandEditor
        client:load
        school={school.slug}
        creditable={CREDITABLE_IMAGES}
        images={images}
        colors={colors}
        accept={ALLOWED_IMAGE_TYPES.join(",")}
        acceptLabel={imageTypeLabel}
      />
    ) : (
      <p class="mt-8 rounded-card border border-gray-200 bg-white px-5 py-4 text-sm leading-relaxed text-gray-600">
        {staff
          ? "You're viewing this as XtraPoint staff — edit this school's brand in the Studio."
          : "This is a view-only link. Ask your XtraPoint contact for an account if you'd like to update your brand yourself."}
      </p>
    )
  }

  <!-- ===================== CURRENT FILES ===================== -->
  <section class="mt-12 border-t border-gray-200 pt-8">
    <h2 class="text-sm font-bold text-gray-900">What we're using now</h2>
    <p class="mt-1 text-sm text-gray-500">
      The exact files and colors on your live pages today — grab these so
      anything you make matches.
    </p>

    {
      logos.length > 0 && (
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          {logos.map((logo) => (
            <div class="rounded-card border border-gray-200 bg-white p-5">
              <div class="flex h-20 items-center justify-center rounded-lg bg-ink p-3">
                <img src={logo.url} alt={logo.title} class="max-h-full max-w-full object-contain" />
              </div>
              <h3 class="mt-4 text-sm font-bold text-gray-900">{logo.title}</h3>
              <a
                href={download(logo.url, logo.label)}
                class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-lime-dark hover:underline"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
                Download
              </a>
            </div>
          ))}
        </div>
      )
    }

    <div class="mt-4 rounded-card border border-gray-200 bg-white p-5">
      <h3 class="text-sm font-bold text-gray-900">Color values</h3>
      <p class="mt-1 text-sm text-gray-500">Click a swatch to copy its hex value.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        {
          swatches.map((s) => (
            <button
              type="button"
              data-copy={s.hex}
              class="flex items-center gap-3 rounded-full border border-gray-200 py-1.5 pl-1.5 pr-4 text-left transition-colors hover:bg-gray-50"
              title={`Copy ${s.hex}`}
            >
              <span
                class="h-8 w-8 shrink-0 rounded-full border border-black/10"
                style={`background:${s.hex}`}
                aria-hidden="true"
              />
              <span>
                <span data-copy-label class="block text-xs font-semibold text-gray-900">
                  {s.name}
                </span>
                <span class="block font-mono text-xs uppercase text-gray-500">{s.hex}</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </section>
</PortalLayout>
