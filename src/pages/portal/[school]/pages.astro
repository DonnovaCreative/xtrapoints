---
// MARKETING PORTAL → Your pages.
//
// Public links reflect the published snapshot. Current drafts are available
// through an authenticated preview, including before a school's first launch.
export const prerender = false;

import PortalLayout from "@/layouts/PortalLayout.astro";
import { gatePortal } from "@/lib/portalRoute";
import { brand } from "@/config/brand";

const gate = await gatePortal(Astro);
if (!gate.ok) return gate.response;
const { school, base, via, staff, live, livePages } = gate;

const productionOrigin = (Astro.site ?? new URL(Astro.url.origin)).origin;

// A school can be live with only one of its two pages published (XtraPoint sets
// that per page in the CMS), so "live" is per row, not per school — otherwise
// this card would show a link to a page that 404s.
const pages = [
  {
    title: "Donor page",
    note: `Where supporters sign up to give to ${school.givingDest}.`,
    path: `/schools/${school.slug}`,
    preview: `${base}/preview?view=donor`,
    live: live && livePages.donor,
  },
  {
    title: "Ambassador page",
    note: `Recruiting page for the ${school.programName} Ambassador program.`,
    path: `/schools/${school.slug}/ambassadors`,
    preview: `${base}/preview?view=ambassador`,
    live: live && livePages.ambassador,
  },
];
// The banner still speaks for the school as a whole.
const anyLive = pages.some((p) => p.live);
const allLive = pages.every((p) => p.live);
---

<PortalLayout school={school} base={base} active="pages" via={via} staff={staff}>
  <div
    class={`mt-6 rounded-card border px-5 py-4 ${
      anyLive ? "border-gray-200 bg-white" : "border-amber-200 bg-amber-50"
    }`}
  >
    <p class={`text-sm leading-relaxed ${anyLive ? "text-gray-600" : "text-amber-900"}`}>
      {
        anyLive && !allLive ? (
          <>
            <strong class="font-bold text-gray-900">Part of your site is live.</strong>{" "}
            The pages marked Live below are public — share those links. The rest
            remain unpublished. Use the private preview to review draft changes.
          </>
        ) : allLive ? (
          <>
            <strong class="font-bold text-gray-900">Your pages are live.</strong> Share
            the {brand.name} links below. Draft changes appear in your private
            preview and go live when published by an authorized administrator.
          </>
        ) : (
          <>
            <strong class="font-bold">Not live yet.</strong> Review your pages
            privately before launch. XtraPoint will publish your initial
            school-approved release to {brand.domain} when it is ready.
          </>
        )
      }
    </p>
  </div>

  <div class="mt-6 space-y-4">
    {
      pages.map((page) => (
        <div class="rounded-card border border-gray-200 bg-white p-5">
          <h2 class="text-base font-bold text-gray-900">{page.title}</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-gray-600">{page.note}</p>

          <div class="mt-4 divide-y divide-gray-100 border-t border-gray-100">
            {/* ── Live site ── */}
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 py-3">
              <span
                class={`inline-flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-1 font-mono text-[0.625rem] uppercase tracking-wider ${
                  page.live ? "bg-green-50 text-green-700" : "bg-gray-100 text-gray-500"
                }`}
              >
                <span
                  class={`h-1.5 w-1.5 rounded-full ${page.live ? "bg-green-500" : "bg-gray-400"}`}
                  aria-hidden="true"
                />
                {page.live ? "Live" : "Not live"}
              </span>

              <span class="min-w-0 flex-1">
                <span class="block text-xs font-semibold text-gray-900">
                  {brand.domain}
                </span>
                <span class="block truncate font-mono text-xs text-gray-400">
                  {page.live ? `${productionOrigin}${page.path}` : "Not published yet"}
                </span>
              </span>

              {page.live ? (
                <span class="flex shrink-0 items-center gap-2">
                  <a
                    href={`${productionOrigin}${page.path}`}
                    class="inline-flex items-center rounded-full bg-lime px-4 py-2 text-sm font-semibold text-on-accent transition-colors hover:bg-lime-deep"
                  >
                    View
                  </a>
                  <button
                    type="button"
                    data-copy={`${productionOrigin}${page.path}`}
                    class="inline-flex items-center rounded-full border border-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50"
                  >
                    Copy link
                  </button>
                </span>
              ) : (
                <span class="shrink-0 text-xs text-gray-400">Available once published</span>
              )}
            </div>

            {/* ── Preview ── */}
            {via === "session" ? <div class="flex flex-wrap items-center gap-x-3 gap-y-2 py-3">
              <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-1 font-mono text-[0.625rem] uppercase tracking-wider text-gray-600">
                Preview
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-xs font-semibold text-gray-900">
                  Current draft · requires your school account
                </span>
                <span class="block truncate font-mono text-xs text-gray-400">
                  Changes here do not affect the published page.
                </span>
              </span>
              <a
                href={page.preview}
                class="inline-flex shrink-0 items-center rounded-full border border-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50"
              >
                Preview draft
              </a>
            </div> : <p class="py-3 text-xs text-gray-500">Sign in with your school account to review unpublished page drafts.</p>}
          </div>
        </div>
      ))
    }
  </div>
</PortalLayout>
