---
// MARKETING PORTAL → Your pages.
//
// A school's page exists in two places and they mean different things, so the
// card shows both rather than picking one and hoping:
//
//   Staging    — always there once the school is published. A working preview:
//                every edit lands here first, and it's how they check their page
//                before it's public. Not for sharing.
//   Production — xtrapoint.com. Only exists once XtraPoint has approved them, and
//                shows the APPROVED version, which can be older than staging.
//
// Showing only one URL (which is what this did before) made "is my page live?"
// unanswerable, and risked a school sharing a staging link with donors.
export const prerender = false;

import PortalLayout from "@/layouts/PortalLayout.astro";
import { gatePortal } from "@/lib/portalRoute";
import { brand } from "@/config/brand";

const gate = await gatePortal(Astro);
if (!gate.ok) return gate.response;
const { school, base, via, staff, live } = gate;

const productionOrigin = (Astro.site ?? new URL(Astro.url.origin)).origin;
const stagingOrigin =
  import.meta.env.PUBLIC_STAGING_ORIGIN ?? "https://staging.xtrapoint.com";

const pages = [
  {
    title: "Donor page",
    note: `Where supporters sign up to give to ${school.givingDest}.`,
    path: `/schools/${school.slug}`,
  },
  {
    title: "Ambassador page",
    note: `Recruiting page for the ${school.programName} Ambassador program.`,
    path: `/schools/${school.slug}/ambassadors`,
  },
];
---

<PortalLayout school={school} base={base} active="pages" via={via} staff={staff}>
  <div
    class={`mt-6 rounded-card border px-5 py-4 ${
      live ? "border-gray-200 bg-white" : "border-amber-200 bg-amber-50"
    }`}
  >
    <p class={`text-sm leading-relaxed ${live ? "text-gray-600" : "text-amber-900"}`}>
      {
        live ? (
          <>
            <strong class="font-bold text-gray-900">Your pages are live.</strong> Share
            the {brand.name} links below. Anything you change shows on the preview
            first, and goes live once we've approved it.
          </>
        ) : (
          <>
            <strong class="font-bold">Not live yet.</strong> Your pages exist as
            previews so you can get them right. We'll publish them to{" "}
            {brand.domain} when you're ready — please don't share the preview links
            in the meantime.
          </>
        )
      }
    </p>
  </div>

  <div class="mt-6 space-y-4">
    {
      pages.map((page) => (
        <div class="rounded-card border border-gray-200 bg-white p-5">
          <h2 class="text-base font-bold text-gray-900">{page.title}</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-gray-600">{page.note}</p>

          <div class="mt-4 divide-y divide-gray-100 border-t border-gray-100">
            {/* ── Live site ── */}
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 py-3">
              <span
                class={`inline-flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-1 font-mono text-[0.625rem] uppercase tracking-wider ${
                  live ? "bg-green-50 text-green-700" : "bg-gray-100 text-gray-500"
                }`}
              >
                <span
                  class={`h-1.5 w-1.5 rounded-full ${live ? "bg-green-500" : "bg-gray-400"}`}
                  aria-hidden="true"
                />
                {live ? "Live" : "Not live"}
              </span>

              <span class="min-w-0 flex-1">
                <span class="block text-xs font-semibold text-gray-900">
                  {brand.domain}
                </span>
                <span class="block truncate font-mono text-xs text-gray-400">
                  {live ? `${productionOrigin}${page.path}` : "Not published yet"}
                </span>
              </span>

              {live ? (
                <span class="flex shrink-0 items-center gap-2">
                  <a
                    href={`${productionOrigin}${page.path}`}
                    class="inline-flex items-center rounded-full bg-lime px-4 py-2 text-sm font-semibold text-on-accent transition-colors hover:bg-lime-deep"
                  >
                    View
                  </a>
                  <button
                    type="button"
                    data-copy={`${productionOrigin}${page.path}`}
                    class="inline-flex items-center rounded-full border border-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50"
                  >
                    Copy link
                  </button>
                </span>
              ) : (
                <span class="shrink-0 text-xs text-gray-400">Available once approved</span>
              )}
            </div>

            {/* ── Preview ── */}
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 py-3">
              <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-1 font-mono text-[0.625rem] uppercase tracking-wider text-gray-600">
                Preview
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-xs font-semibold text-gray-900">
                  Latest version, including anything awaiting review
                </span>
                <span class="block truncate font-mono text-xs text-gray-400">
                  {stagingOrigin}
                  {page.path}
                </span>
              </span>
              <a
                href={`${stagingOrigin}${page.path}`}
                class="inline-flex shrink-0 items-center rounded-full border border-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50"
              >
                View
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</PortalLayout>
