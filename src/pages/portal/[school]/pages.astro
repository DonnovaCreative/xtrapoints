---
// MARKETING PORTAL → Your pages. The school's two live URLs, with copy buttons
// so they can be pasted straight into an email or a bio link.
export const prerender = false;

import PortalLayout from "@/layouts/PortalLayout.astro";
import { gatePortal } from "@/lib/portalRoute";

const gate = await gatePortal(Astro);
if (!gate.ok) return gate.response;
const { school, base, via, staff, live } = gate;

// Where these pages actually exist right now.
//
// A school that hasn't been approved for production has no pages on
// xtrapoint.com yet — linking there would hand them a 404 of their own landing
// page. Until they're live, point at staging and say so; once live, the real
// URLs, which is also what "Copy link" should hand over.
const origin = live
  ? (Astro.site ?? new URL(Astro.url.origin)).origin
  : (import.meta.env.PUBLIC_STAGING_ORIGIN ?? "https://staging.xtrapoint.com");
const abs = (path: string) => `${origin}${path}`;

const pages = [
  {
    title: "Donor page",
    note: `Where supporters sign up to give to ${school.givingDest}.`,
    href: `/schools/${school.slug}`,
  },
  {
    title: "Ambassador page",
    note: `Recruiting page for the ${school.programName} Ambassador program.`,
    href: `/schools/${school.slug}/ambassadors`,
  },
];
---

<PortalLayout school={school} base={base} active="pages" via={via} staff={staff}>
  {
    !live && (
      <div class="mt-6 rounded-card border border-gray-200 bg-white px-5 py-4">
        <p class="text-sm leading-relaxed text-gray-600">
          <strong class="font-bold text-gray-900">Not live yet.</strong> These are
          working previews so you can see your pages and get them right. We'll send
          you the public links the moment they go live — don't share these ones.
        </p>
      </div>
    )
  }

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      pages.map((page) => (
        <div class="flex flex-col rounded-card border border-gray-200 bg-white p-5">
          <div class="flex items-start justify-between gap-3">
            <h2 class="text-base font-bold text-gray-900">{page.title}</h2>
            {!live && (
              <span class="shrink-0 rounded-full bg-gray-100 px-2.5 py-1 font-mono text-[0.625rem] uppercase tracking-wider text-gray-500">
                Preview
              </span>
            )}
          </div>
          <p class="mt-1.5 flex-1 text-sm leading-relaxed text-gray-600">{page.note}</p>
          <p class="mt-3 truncate font-mono text-xs text-gray-400">{abs(page.href)}</p>
          <div class="mt-4 flex items-center gap-2">
            <a
              href={abs(page.href)}
              class="inline-flex items-center gap-1.5 rounded-full bg-lime px-4 py-2 text-sm font-semibold text-on-accent transition-colors hover:bg-lime-deep"
            >
              View page
            </a>
            {live && (
              <button
                type="button"
                data-copy={abs(page.href)}
                class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50"
              >
                Copy link
              </button>
            )}
          </div>
        </div>
      ))
    }
  </div>
</PortalLayout>
