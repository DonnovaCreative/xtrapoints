---
// Published snapshots are read on demand so a school launch needs no site rebuild.
export const prerender = false;
import SchoolLanding from "@/components/school/SchoolLanding.astro";
import { getSchool, getSiteSettings } from "@/data/schoolsSource";
const [school, settings] = await Promise.all([getSchool(Astro.params.school!), getSiteSettings()]);
if (!school || !school.livePages.donor) return new Response('Page not found', {status:404});
Astro.response.headers.set('Cache-Control','public, max-age=0, must-revalidate');
Astro.response.headers.set('CDN-Cache-Control','public, max-age=30');
---

<SchoolLanding school={school} settings={settings} />
