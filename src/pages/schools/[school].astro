---
import Layout from "@/layouts/Layout.astro";
import SchoolHeader from "@/components/school/SchoolHeader.astro";
import SchoolPhotoBand from "@/components/school/SchoolPhotoBand.astro";
import SchoolFooter from "@/components/school/SchoolFooter.astro";
import CtaButton from "@/components/CtaButton.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import PlaybookMark from "@/components/PlaybookMark.astro";
import SchoolPhone from "@/components/school/SchoolPhone.astro";
import DotField from "@/components/islands/DotField.tsx";
import ContactForm from "@/components/islands/ContactForm.tsx";
import { schoolThemeVars, hexToRgba } from "@/data/schools";
import { getSchools, getSiteSettings } from "@/data/schoolsSource";
import { brand } from "@/config/brand";

export async function getStaticPaths() {
  const schools = await getSchools();
  return schools.map((school) => ({ params: { school: school.slug }, props: { school } }));
}

const { school } = Astro.props;
const settings = await getSiteSettings();
const t = school.theme;
const themeStyle = schoolThemeVars(t);
const ambassadorUrl = `/schools/${school.slug}/ambassadors`;

// Simple, donor-facing "how to sign up" steps (the step-by-step the page should push).
const steps = [
  { n: "01", title: "Download the app.", body: `Get the ${brand.name} app, free, and pick the ${school.mascot}. (Coming soon to the App Store & Google Play.)` },
  { n: "02", title: "Link a card securely.", body: "Connect a card in seconds — verified in real time by Plaid. Your bank login is never shared with us." },
  { n: "03", title: "Round up for the team.", body: `Every purchase rounds up to the nearest dollar, and your spare change becomes a gift to the ${school.fund}.` },
];

// Donor-facing advantages.
const advantages = [
  { title: "Effortless", body: "Round-ups happen automatically in the background. Set it once and forget it." },
  { title: "Free to give", body: "No fees to participate — you decide how much you round up each month." },
  { title: "It adds up", body: `Spare change from everyday spending becomes steady, recurring support for the ${school.fund}.` },
  { title: "Bank-level security", body: "Card connections are verified and protected by Plaid. Your details stay safe." },
  { title: "Cancel anytime", body: "Pause or stop whenever you like — right from the app, no questions asked." },
  { title: "Anyone can join", body: "Students, alumni, family, friends, and local fans can all pitch in for the team." },
];
---

<Layout
  title={`${school.short} × ${brand.name} — Round-Up Giving`}
  description={`Round-up giving for the ${school.fund}: your everyday spare change supports the ${school.mascot}, free. From ${brand.name} — launching soon.`}
  ogImage={`/schools/${school.slug}/og.png`}
>
  <div style={themeStyle}>
    <SchoolHeader
      school={school}
      nav={{ label: "Become an Ambassador", href: ambassadorUrl }}
      cta={{ label: "Get early access", href: "#start" }}
    />

    <main>
      <!-- ===================== HERO ===================== -->
      <section class="relative overflow-hidden bg-ink">
        {school.photos?.team && (
          <div class="absolute inset-0 z-0" aria-hidden="true">
            <img src={school.photos.team} alt="" class="h-full w-full object-cover object-[center_22%] opacity-30" />
            <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/90 to-ink/55"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent to-transparent"></div>
          </div>
        )}
        <div class="absolute inset-0 z-0" aria-hidden="true">
          <DotField client:load dotSpacing={26} dotRadius={2} bulgeStrength={60} glowRadius={200} gradientFrom={hexToRgba(t.primary, 0.5)} gradientTo={hexToRgba(t.secondary, 0.18)} glowColor={hexToRgba(t.primary, 0.5)} />
        </div>
        <div class="dot-grid-OFF"></div>
        <div class="glow anim-float-1" style={`width:460px;height:460px;top:-8%;right:6%;background:radial-gradient(circle,${t.secondarySoft} 0%,transparent 65%);opacity:0.9;`} aria-hidden="true"></div>
        <PlaybookMark mark="x" class="right-6 top-6 h-16 w-16 lg:right-12 lg:top-10 lg:h-24 lg:w-24" rotate={10} opacity={0.9} delay={0.4} color="var(--color-accent-2)" />

        <div class="relative z-10 mx-auto grid max-w-7xl gap-12 px-6 pb-20 pt-[calc(var(--header-h)+3.5rem)] lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:px-10 lg:pb-28 lg:pt-[calc(var(--header-h)+5rem)]">
          <div>
            <p class="inline-flex items-center gap-2 rounded-full bg-accent-2-soft px-3 py-1 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-accent-2">
              <span class="h-1.5 w-1.5 rounded-full bg-accent-2"></span>Launching soon · {school.short}
            </p>
            <h1 class="font-display mt-4 text-[clamp(3rem,7vw,5.25rem)] uppercase leading-[1.02] tracking-tight text-white">
              Every purchase, a
              <span class="font-editorial my-1 block text-[1.1em] leading-[0.9] text-lime [text-transform:none]">small act of support</span>
              for the {school.mascot}.
            </h1>
            <div class="reveal">
              <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/75">
                Soon you'll link a card once and your everyday spending will round
                up into automatic gifts for the {school.fund} — powered by
                {" "}{brand.name}. No cost to you, and it takes about two minutes.
              </p>
              <div class="mt-8 flex flex-wrap items-center gap-4">
                <CtaButton href="#start" variant="lime" glow={false}>Get early access</CtaButton>
                <span class="font-mono text-xs uppercase tracking-[0.04em] text-white/50">Free · Round up · Cancel anytime</span>
              </div>
            </div>
          </div>
          <div class="relative reveal-right"><SchoolPhone fund={school.fund} mascot={school.mascot} mark={school.mark} avatar={school.avatar} /></div>
        </div>
      </section>

      <!-- ===================== HOW IT WORKS ===================== -->
      <section class="relative overflow-hidden bg-white py-20 lg:py-28">
        <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-10">
          <div class="reveal max-w-3xl">
            <Eyebrow index="01" label="How it works" />
            <h2 class="font-display mt-4 max-w-[18ch] text-[clamp(2.5rem,6vw,4rem)] uppercase leading-[0.92] tracking-[-0.015em] text-gray-900">
              Signing up is <span class="ed ed-dark">Simple</span>.
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              Three quick steps and your spare change starts supporting the
              {" "}{school.mascot} — without changing how you already spend.
            </p>
          </div>
          <div class="stagger mt-14 grid gap-6 md:grid-cols-3">
            {steps.map((s) => (
              <div class="rounded-2xl border border-gray-200 p-8 transition-colors hover:bg-gray-50">
                <span class="font-display text-3xl leading-none text-lime-dark">{s.n}</span>
                <h3 class="mt-4 text-xl font-bold tracking-tight text-gray-900">{s.title}</h3>
                <p class="mt-3 leading-relaxed text-gray-600">{s.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================== SPIRIT BAND ===================== -->
      {school.photos?.celebrate && (
        <SchoolPhotoBand src={school.photos.celebrate} position="center 28%">
          <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-accent-2">Eat 'em up, Kats</p>
          <h2 class="font-display mt-4 text-[clamp(2.5rem,6vw,4.5rem)] uppercase leading-[0.95] tracking-tight text-white">
            From the stands to the <span class="ed">scoreboard</span>.
          </h2>
          <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/80">
            Every {school.mascot} fan can fuel the program — turning everyday
            spending into real support for the team you love.
          </p>
        </SchoolPhotoBand>
      )}

      <!-- ===================== WHY GIVE / ADVANTAGES ===================== -->
      <section class="relative overflow-hidden bg-gray-50 py-20 lg:py-28">
        <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-10">
          <div class="reveal max-w-3xl">
            <Eyebrow index="02" label="Why give this way" />
            <h2 class="font-display mt-4 max-w-[20ch] text-[clamp(2.5rem,6vw,4rem)] uppercase leading-[0.92] tracking-[-0.015em] text-gray-900">
              Tiny change, <span class="ed ed-dark">Real impact</span>.
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              Round-up giving turns the everyday into something the {school.mascot}
              feel all season long.
            </p>
          </div>
          <div class="stagger mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {advantages.map((a) => (
              <div class="rounded-2xl border border-gray-200 bg-white p-7">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-lime-soft text-lime-dark">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
                </span>
                <h3 class="mt-4 text-lg font-bold tracking-tight text-gray-900">{a.title}</h3>
                <p class="mt-2 leading-relaxed text-gray-600">{a.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================== AMBASSADOR CALLOUT ===================== -->
      <section class="relative overflow-hidden bg-ink py-20 text-white lg:py-28">
        <div class="dot-grid"></div>
        <PlaybookMark mark="o" class="left-[5%] top-[16%] hidden h-16 w-16 lg:block" rotate={-8} opacity={0.18} color="var(--color-accent-2)" />
        <div class="relative z-10 mx-auto grid max-w-7xl items-center gap-12 px-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:px-10">
          <div class="reveal-left">
            <Eyebrow index="03" label="For students" dark />
            <h2 class="font-display mt-4 text-[clamp(2.5rem,6vw,4rem)] uppercase leading-[0.92] tracking-[-0.015em] text-white">
              Become a {school.short} <span class="ed">Ambassador</span>.
            </h2>
            <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/75">
              Are you a {school.short} student? Lead the movement on campus —
              spread the word, sign up donors, and earn swag, gift cards, VIP
              experiences, and leadership recognition as you climb from Bronze to
              Gold.
            </p>
            <a href={ambassadorUrl} class="mt-8 inline-flex w-fit items-center gap-2.5 rounded-full bg-lime px-6 py-3.5 text-[0.9375rem] font-bold text-on-accent transition-all duration-300 hover:bg-lime-deep hover:-translate-y-0.5">
              Explore the Ambassador Program
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <div class="reveal-right">
            <img src={school.photos?.fans ?? "/images/ambassador-default.png"} alt={`${school.short} students in the stands`} loading="lazy" class="aspect-[4/3] w-full rounded-3xl object-cover shadow-2xl ring-1 ring-white/10" />
          </div>
        </div>
      </section>

      <!-- ===================== INTEREST / GET EARLY ACCESS ===================== -->
      <section id="start" class="relative overflow-hidden bg-white py-20 lg:py-28">
        <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-10">
          <div class="grid items-center gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
            <div class="reveal-left">
              <Eyebrow index="04" label="Get early access" />
              <h2 class="font-display mt-4 text-[clamp(2.5rem,6vw,4rem)] uppercase leading-[0.92] tracking-[-0.015em] text-gray-900">
                Be first to back the <span class="ed ed-dark">{school.mascot}</span>.
              </h2>
              <p class="mt-5 max-w-md text-lg leading-relaxed text-gray-600">
                Round-up giving for the {school.fund} is almost here. Join the
                waitlist and we'll tell you the moment it goes live — so you can be
                among the first {school.mascot} fans to start giving.
              </p>
              <ul class="mt-8 flex flex-col gap-3 text-gray-700">
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-lime"></span>Free to join · you choose how much you round up</li>
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-lime"></span>Set it once · cancel anytime</li>
                <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-lime"></span>Card connections secured by Plaid</li>
              </ul>
            </div>
            <div class="reveal-right rounded-3xl bg-white p-6 shadow-2xl ring-1 ring-gray-200 sm:p-8 lg:p-10">
              <h3 class="text-2xl font-bold tracking-tight text-gray-900">Join the waitlist</h3>
              <p class="mt-2 text-gray-600">No spam — just a heads-up the day we launch.</p>
              <div class="mt-7"><ContactForm client:load school={school.name} variant="interest" /></div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <SchoolFooter legalCopy={settings.legalCopy} />
  </div>
</Layout>
