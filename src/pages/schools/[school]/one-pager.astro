---
// =============================================================================
// Co-branded SALES ONE-PAGER — the print/PDF sell sheet, re-skinned per school.
//
// This is the HTML source of truth for /schools/<slug>/one-pager.pdf (rendered
// to PDF on demand by one-pager.pdf.ts via headless Chromium). It reads the SAME
// Sanity data as the landing pages and re-skins through `schoolThemeVars`, so a
// new school gets its branded sell sheet automatically — no manual design.
//
// Sized to a single US-Letter sheet (8.5in × 11in). Everything variable per
// school comes from the theme + logo; all copy below is static (identical for
// every school). Colors follow the site rule: PRIMARY = CTAs / editorial /
// checks / eyebrows; SECONDARY = atmospheric (hero gradient end, glows,
// watermark) — so the CTA always pops even for single-color brands.
// =============================================================================
import Layout from "@/layouts/Layout.astro";
import { schoolThemeVars } from "@/data/schools";
import { getSchools } from "@/data/schoolsSource";
import { brand } from "@/config/brand";

export async function getStaticPaths() {
  const schools = await getSchools();
  return schools.map((school) => ({ params: { school: school.slug }, props: { school } }));
}

const { school } = Astro.props;
const themeStyle = schoolThemeVars(school.theme);

// The app-avatar mark is tinted to the accent via a CSS mask. Browsers won't
// apply a cross-origin mask image (marks live on the Sanity CDN), so fetch the
// SVG at build and inline it as a same-origin data URI (same trick as
// SchoolPhone.astro).
let maskStyle = "";
if (school.mark) {
  let maskSrc = school.mark;
  if (/^https?:\/\//.test(school.mark)) {
    try {
      const svg = await fetch(school.mark).then((r) => r.text());
      maskSrc = `data:image/svg+xml,${encodeURIComponent(svg)}`;
    } catch {
      maskSrc = school.mark;
    }
  }
  maskStyle = `mask:url("${maskSrc}") center/contain no-repeat;-webkit-mask:url("${maskSrc}") center/contain no-repeat;background:var(--color-lime);`;
}

const check = `M5 13l4 4L19 7`;
const arrow = `M3 8h10M9 4l4 4-4 4`;

// Static selling points (identical for every school).
const trust = ["$0 upfront cost", "Live in days", "No long contracts"];
const outcomes = [
  "Recurring revenue you can forecast — not a single year-end scramble to close the books.",
  "A new pipeline of donors who'd never have written a check, now giving automatically every day.",
  "More of every dollar reaches your program — lower transaction fees than competing round-up platforms.",
];
---

<Layout
  title={`${school.short} × ${brand.name} — Sales One-Pager`}
  description={`Co-branded ${brand.name} sell sheet for ${school.name}.`}
  noindex
>
  <div class="op-stage" style={themeStyle}>
    <!-- Download button — screen only; hidden in the print/PDF render. -->
    <a
      href={`/schools/${school.slug}/one-pager.pdf`}
      class="op-download noprint"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"/></svg>
      Download PDF
    </a>

    <div class="sheet font-sans text-gray-900">
      <!-- ===================== HERO ===================== -->
      <section class="op-hero">
        <!-- watermark: giant faint school logo, clipped to the hero -->
        {school.logo && (
          <img src={school.logo} alt="" aria-hidden="true" class="op-watermark" />
        )}

        <!-- top bar: XtraPoint (left) + school lockup (right) -->
        <header class="op-topbar">
          <img src={brand.logo.white} alt={brand.nameSpaced} class="h-7 w-auto" />
          {school.logo ? (
            <span class={`op-lockup ${school.logoBadge ? "op-lockup--badge" : ""}`}>
              <img src={school.logo} alt={school.name} class={school.logoClass ?? "h-9 w-auto"} />
            </span>
          ) : (
            <span class="text-right leading-tight text-white">
              <span class="block font-display text-2xl uppercase">{school.short}</span>
              <span class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-white/70">{school.mascot}</span>
            </span>
          )}
        </header>

        <div class="op-hero-grid">
          <div class="op-hero-copy">
            <span class="op-pill">Recurring giving · {school.short}</span>
            <h1 class="op-h1">Turn everyday purchases into recurring support for your team.</h1>
            <p class="op-lede">
              {brand.name} helps athletic departments, booster clubs, and alumni
              associations turn everyday spending into recurring donor revenue —
              paired with the marketing arm to grow it. From spare-change round-ups
              to large one-time gifts, every donation strengthens your program.
            </p>
            <ul class="op-trust">
              {trust.map((t) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={check}/></svg>
                  {t}
                </li>
              ))}
            </ul>
          </div>

          <!-- compact branded app mockup -->
          <div class="op-phone-wrap" aria-hidden="true">
            <div class="op-chip op-chip--top">
              <span class="op-chip-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></span>
              <span><span class="op-chip-label">Round-up</span><span class="op-chip-val">$0.43</span></span>
            </div>
            <div class="op-chip op-chip--bot">
              <span class="op-chip-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7M21 4v5h-5"/></svg></span>
              <span><span class="op-chip-label">Recurring</span><span class="op-chip-val">Monthly</span></span>
            </div>
            <div class="op-phone">
              <div class="op-island"></div>
              <div class="op-screen">
                <div class="op-statusbar"><span>9:41</span><span class="op-signal"></span></div>
                <div class="op-org">
                  {school.avatar ? (
                    <span class="op-avatar op-avatar--img"><img src={school.avatar} alt="" /></span>
                  ) : school.mark ? (
                    <span class="op-avatar op-avatar--mark"><span style={maskStyle}></span></span>
                  ) : (
                    <span class="op-avatar op-avatar--letter">{school.fund.charAt(0)}</span>
                  )}
                  <span class="op-org-name">{school.fund}</span>
                </div>
                <div class="op-donation">
                  <p class="op-donation-eyebrow">Next minimum donation</p>
                  <p class="op-donation-amt">$15.00</p>
                  <p class="op-donation-date">10 / 31 / 2026</p>
                  <div class="op-progress"><span></span></div>
                  <div class="op-addcard"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Add another card</div>
                </div>
                <div class="op-quick">
                  <p>Looking to give a little extra?</p>
                  <div class="op-quick-row">
                    <span>$5</span><span class="on">$25</span><span>$50</span><span>$100</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== OUTCOME ===================== -->
      <section class="op-outcome">
        <div>
          <h2 class="op-h2">The outcome: <span class="op-accent">recurring donors you wouldn't otherwise have.</span></h2>
          <p class="op-body">
            Boosters, alumni, and fans want to give — they just want it to be easy.
            {brand.name} captures the small recurring gifts you'd otherwise leave on
            the table, turning one-off donors into a predictable revenue stream you
            can plan a season around.
          </p>
        </div>
        <ul class="op-checklist">
          {outcomes.map((o) => (
            <li>
              <span class="op-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d={check}/></svg></span>
              <span>{o}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- ===================== TWO FEATURE COLUMNS ===================== -->
      <section class="op-features">
        <div>
          <p class="op-eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>Fast to market</p>
          <h3 class="op-h3">Live in hours, not quarters.</h3>
          <p class="op-body">
            Done-for-you onboarding means zero-touch setup on your end — no setup
            fees, no long contracts. Your supporters download the app, link an
            account, and start contributing. You're live in days, not the next
            budget cycle.
          </p>
          <ul class="op-arrows">
            <li><span class="op-arrow"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={arrow}/></svg></span><span><b>Zero implementation cost</b> and no IT lift for your staff.</span></li>
            <li><span class="op-arrow"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={arrow}/></svg></span><span><b>Branded app in your colors</b> — instant transparency for donors.</span></li>
          </ul>
        </div>
        <div>
          <p class="op-eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 14v-3zM3 11v3M9 12.5V17a2 2 0 0 0 4 0"/></svg>Marketing support</p>
          <h3 class="op-h3">A full marketing arm — without the headcount.</h3>
          <p class="op-body">
            Not every department has a 20-person comms team. For the program where
            one person handles everything, {brand.name} includes done-for-you
            marketing campaigns that drive more supporters to your platform — so a
            one-admin shop can reach donors like a program with a full agency.
          </p>
          <ul class="op-arrows">
            <li><span class="op-arrow"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={arrow}/></svg></span><span><b>Pre-built campaign playbooks</b> — kickoff, year-end, championship runs.</span></li>
            <li><span class="op-arrow"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={arrow}/></svg></span><span><b>Automated re-engagement</b> that wins back lapsed supporters on its own.</span></li>
          </ul>
        </div>
      </section>

      <!-- ===================== AMBASSADOR BAND ===================== -->
      <section class="op-ambassador">
        <p class="op-eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-2a4 4 0 0 1 4-4h4M20 8v6M23 11h-6M15 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/></svg>Ambassador program</p>
        <h3 class="op-h3">Put your students to work for your program.</h3>
        <p class="op-body">
          The Ambassador Program turns students into a grassroots growth engine —
          driving app sign-ups, verified registrations, and recurring donors through
          channels staff outreach can't reach: Greek life, tailgates, orientation.
          It's low-cost, always-on marketing that builds school pride today and a
          pipeline of future alumni donors who give for years after they graduate.
        </p>
      </section>

      <!-- ===================== PRODUCT FEATURES ===================== -->
      <section class="op-product">
        <p class="op-eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 4.8L20 8l-4 3.6L17 18l-5-2.6L7 18l1-6.4L4 8l5.6-1.2z"/></svg>Product features</p>
        <p class="op-body">
          <b>One-time, recurring &amp; round-up giving</b> · weekly / monthly /
          quarterly / annual schedules · <b>cards, Apple&nbsp;Pay &amp; bank
          transfers</b> · tribute &amp; team giving in honor or memory · a branded
          mobile app · and <b>a single dashboard</b> tracking every donor, campaign,
          and transaction with real-time activity and lifetime-value insight.
        </p>
      </section>

      <!-- ===================== CTA FOOTER ===================== -->
      <footer class="op-cta">
        <div>
          <h2 class="op-cta-h">Ready to launch your program's giving platform?</h2>
          <p class="op-cta-body">
            Partnering is simple: we provide the platform, the toolkit, and the
            coaching — your campus brings the energy. Let's design a kickoff for
            your next season.
          </p>
        </div>
        <div class="op-cta-right">
          <a href={`https://${brand.domain}`} class="op-cta-btn">
            Learn more
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
          <a href={`mailto:${brand.salesEmail}`} class="op-cta-mail">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            {brand.salesEmail}
          </a>
        </div>
        <p class="op-copyright">© 2026 LaCore Payments Technologies, Inc. All rights reserved.</p>
      </footer>
    </div>
  </div>
</Layout>

<style is:global>
  /* ---- Print / PDF page setup ---- */
  @page {
    size: Letter;
    margin: 0;
  }
  .op-stage {
    display: flex;
    justify-content: center;
    padding: 24px;
    background: #e5e7eb;
    min-height: 100vh;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .sheet {
    position: relative;
    width: 8.5in;
    height: 11in;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
  }
  /* Sections keep their natural height (a fixed-height flex column would
     otherwise shrink them below their content); the CTA footer's margin-top:auto
     pins it to the bottom of the sheet. */
  .sheet > * {
    flex-shrink: 0;
  }
  @media print {
    .op-stage {
      padding: 0;
      background: #fff;
      display: block;
      min-height: 0;
    }
    .sheet {
      box-shadow: none;
      width: 8.5in;
      height: 11in;
    }
    .noprint {
      display: none !important;
    }
  }

  .op-download {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--color-ink);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.5);
  }
  .op-download svg {
    width: 18px;
    height: 18px;
  }

  /* ---- HERO ---- */
  .op-hero {
    position: relative;
    overflow: hidden;
    padding: 13px 40px 8px;
    color: #fff;
    background:
      radial-gradient(120% 140% at 82% 20%, var(--color-accent-2) 0%, transparent 55%),
      linear-gradient(100deg, var(--color-lime-dark) 0%, var(--color-lime) 52%, var(--color-accent-2) 100%);
  }
  .op-watermark {
    position: absolute;
    top: -34px;
    right: -30px;
    height: 300px;
    width: auto;
    opacity: 0.1;
    filter: grayscale(1) brightness(0);
    pointer-events: none;
  }
  .op-topbar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .op-lockup--badge {
    display: inline-flex;
    align-items: center;
    background: #fff;
    border-radius: 10px;
    padding: 6px 10px;
  }
  .op-hero-grid {
    position: relative;
    z-index: 2;
    margin-top: 6px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 20px;
    align-items: start;
  }
  .op-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .op-h1 {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 30px;
    line-height: 0.97;
    letter-spacing: -0.01em;
    margin-top: 7px;
    max-width: 15ch;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.18);
  }
  .op-lede {
    margin-top: 8px;
    font-size: 11.5px;
    line-height: 1.34;
    max-width: 46ch;
    color: rgba(255, 255, 255, 0.92);
  }
  .op-trust {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .op-trust li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 13px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.1);
    font-size: 11.5px;
    font-weight: 700;
  }
  .op-trust svg {
    width: 13px;
    height: 13px;
  }

  /* ---- compact phone ---- */
  .op-phone-wrap {
    position: relative;
    height: 232px;
  }
  .op-phone {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%) rotate(-3deg);
    width: 182px;
    height: 288px;
    border-radius: 30px;
    background: #111827;
    padding: 6px;
    box-shadow: 0 30px 60px -25px rgba(0, 0, 0, 0.6);
  }
  .op-island {
    position: absolute;
    left: 50%;
    top: 12px;
    transform: translateX(-50%);
    width: 60px;
    height: 16px;
    border-radius: 999px;
    background: #111827;
    z-index: 3;
  }
  .op-screen {
    height: 100%;
    width: 100%;
    border-radius: 24px;
    background: #fff;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 14px 12px 12px;
    gap: 9px;
  }
  .op-statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 9px;
    font-weight: 600;
    color: #111827;
  }
  .op-signal {
    width: 26px;
    height: 8px;
    border-radius: 2px;
    background: #111827;
    opacity: 0.85;
  }
  .op-org {
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 9px;
  }
  .op-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    flex-shrink: 0;
  }
  .op-avatar--img {
    background: #fff;
    box-shadow: inset 0 0 0 1px #e5e7eb;
    overflow: hidden;
  }
  .op-avatar--img img {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }
  .op-avatar--mark {
    background: var(--color-lime-soft);
  }
  .op-avatar--mark span {
    width: 13px;
    height: 13px;
    display: block;
  }
  .op-avatar--letter {
    background: var(--color-lime);
    color: var(--color-on-accent);
    font-weight: 700;
    font-size: 11px;
  }
  .op-org-name {
    font-size: 9px;
    line-height: 1.15;
    font-weight: 500;
    color: #111827;
  }
  .op-donation {
    border: 1px solid #e5e7eb;
    background: #f9fafb;
    border-radius: 14px;
    padding: 12px;
  }
  .op-donation-eyebrow {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b7280;
    margin-bottom: 5px;
  }
  .op-donation-amt {
    font-size: 26px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #111827;
  }
  .op-donation-date {
    font-family: var(--font-mono);
    font-size: 8px;
    color: #6b7280;
    margin: 4px 0 9px;
  }
  .op-progress {
    height: 3px;
    border-radius: 999px;
    background: #e5e7eb;
    overflow: hidden;
    margin-bottom: 10px;
  }
  .op-progress span {
    display: block;
    height: 100%;
    width: 68%;
    border-radius: 999px;
    background: var(--color-lime);
  }
  .op-addcard {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border-radius: 8px;
    background: var(--color-ink);
    color: #fff;
    font-size: 9.5px;
    font-weight: 600;
    padding: 8px;
  }
  .op-addcard svg {
    width: 11px;
    height: 11px;
  }
  .op-quick {
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 9px;
  }
  .op-quick p {
    text-align: center;
    font-size: 8.5px;
    color: #4b5563;
    margin-bottom: 7px;
  }
  .op-quick-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .op-quick-row span {
    text-align: center;
    font-size: 9px;
    font-weight: 600;
    padding: 6px 0;
    border-radius: 999px;
    border: 1px solid #e5e7eb;
    color: #4b5563;
  }
  .op-quick-row span.on {
    background: var(--color-ink);
    color: #fff;
    border-color: var(--color-ink);
  }
  .op-chip {
    position: absolute;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 8px 11px;
    box-shadow: 0 18px 40px -18px rgba(16, 24, 40, 0.35);
  }
  .op-chip--top {
    top: 34px;
    right: 2px;
  }
  .op-chip--bot {
    bottom: 6px;
    left: -6px;
  }
  .op-chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: var(--color-lime-soft);
    color: var(--color-lime-dark);
  }
  .op-chip-icon svg {
    width: 13px;
    height: 13px;
  }
  .op-chip-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.06em;
