---
// Co-branded SALES ONE-PAGER (published). The HTML source of truth for
// /schools/<slug>/one-pager.pdf. The rendered sheet lives in OnePagerView.astro
// (shared with the secret-gated draft preview); this file just supplies published
// data + points the download button at the published PDF route.
import OnePagerView from "@/components/school/OnePagerView.astro";
import { getSchool } from "@/data/schoolsSource";
export const prerender = false;
const school = await getSchool(Astro.params.school!);
if (!school) return new Response('Page not found', {status:404});
Astro.response.headers.set('Cache-Control','public, max-age=0, must-revalidate');
Astro.response.headers.set('CDN-Cache-Control','public, max-age=30');
---

<OnePagerView school={school} pdfHref={`/schools/${school.slug}/one-pager.pdf`} />
