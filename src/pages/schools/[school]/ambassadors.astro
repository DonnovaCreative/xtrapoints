---
// Static co-branded ambassador page. Body lives in SchoolAmbassadors.astro
// (shared with the draft preview route); this file supplies published data.
import SchoolAmbassadors from "@/components/school/SchoolAmbassadors.astro";
import { getSchools, getSiteSettings } from "@/data/schoolsSource";

export async function getStaticPaths() {
  const [schools, settings] = await Promise.all([
    getSchools(),
    getSiteSettings(),
  ]);
  // A school can launch its donor page before its ambassador page (CMS →
  // Publishing → Pages on xtrapoint.com), so a switched-off ambassador page isn't
  // built at all on production and its URL 404s. Off production every school
  // renders — see schoolsSource `resolveLivePages`.
  return schools
    .filter((school) => school.livePages.ambassador)
    .map((school) => ({
      params: { school: school.slug },
      props: { school, settings },
    }));
}

const { school, settings } = Astro.props;
---

<SchoolAmbassadors school={school} settings={settings} />
