---
// Legal pages (Terms & Conditions, Privacy Policy, …). One dynamic root route,
// one document per page in Sanity (doc type `legalPage`). Adding a legal doc in
// the Studio makes its page + cross-links appear with no code change.
//
// Design: editorial + quiet (à la stripe.com/legal) — a light page, a restrained
// header (no colored hero), and a two-column body with a sticky sidebar that
// carries both the cross-document links and a numbered table of contents
// (scrollspy). Numbers ("01, 02…") are shared between the sidebar outline and the
// body H2s via a CSS counter, for a premium legal-document read. Brand tokens
// only: ink, lime, Space Mono eyebrows, Inter body.
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { brand } from "@/config/brand";
import { getLegalPages, getLegalPage } from "@/data/legalSource";
import { renderLegalBody } from "@/data/legal";

export async function getStaticPaths() {
  const pages = await getLegalPages();
  return pages.map((page) => ({
    params: { legal: page.slug },
    props: { page, all: pages },
  }));
}

const { page, all } = Astro.props;
const { html, toc } = renderLegalBody(page.body);

// Number the top-level (H2) entries so the outline mirrors the body's CSS counter.
let h2n = 0;
const tocItems = toc.map((t) => ({
  ...t,
  num: t.level === 2 ? String(++h2n).padStart(2, "0") : null,
}));

const updated = page.lastUpdated
  ? new Date(`${page.lastUpdated}T00:00:00`).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;

const description = `${page.title} for ${brand.nameSpaced}.`;
---

<Layout title={`${page.title} · ${brand.name}`} description={description}>
  <Header variant="light" />
  <main class="bg-white">
    <!-- page header — restrained, light, editorial -->
    <div class="border-b border-gray-100">
      <div class="mx-auto max-w-7xl px-6 pb-10 pt-[calc(var(--header-h)+3rem)] lg:px-10 lg:pb-14 lg:pt-[calc(var(--header-h)+4rem)]">
        <p
          class="lg-fade flex items-center gap-2.5 font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-gray-400"
        >
          <span class="inline-block h-2 w-2 bg-lime" aria-hidden="true"></span>
          Legal
        </p>
        <h1
          class="lg-fade mt-5 max-w-3xl text-[clamp(2rem,4.5vw,3.25rem)] font-bold leading-[1.05] tracking-tight text-ink"
          style="animation-delay:60ms"
        >
          {page.title}
        </h1>
        {updated && (
          <p
            class="lg-fade mt-4 font-mono text-xs uppercase tracking-[0.1em] text-gray-400"
            style="animation-delay:120ms"
          >
            Last updated {updated}
          </p>
        )}

        <!-- cross-document links (mobile only; sidebar carries them on desktop) -->
        {all.length > 1 && (
          <div
            class="lg-fade mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 lg:hidden"
            style="animation-delay:180ms"
          >
            <span
              class="font-mono text-[0.625rem] uppercase tracking-[0.14em] text-gray-400"
            >
              Documents
            </span>
            {all.map((l) =>
              l.slug === page.slug ? (
                <span aria-current="page" class="text-sm font-medium text-ink">
                  {l.navLabel}
                </span>
              ) : (
                <a
                  href={`/${l.slug}`}
                  class="text-sm text-gray-500 underline-offset-2 transition-colors hover:text-ink hover:underline"
                >
                  {l.navLabel}
                </a>
              ),
            )}
          </div>
        )}
      </div>
    </div>

    <!-- body -->
    <div
      class="mx-auto grid max-w-7xl gap-y-10 px-6 py-12 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-x-20 lg:px-10 lg:py-16"
    >
      <!-- sticky sidebar: documents + on-this-page -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 flex flex-col gap-9">
          {all.length > 1 && (
            <nav aria-label="Legal documents">
              <p
                class="font-mono text-[0.625rem] uppercase tracking-[0.16em] text-gray-400"
              >
                Documents
              </p>
              <ul class="mt-3.5 flex flex-col gap-2">
                {all.map((l) =>
                  l.slug === page.slug ? (
                    <li
                      aria-current="page"
                      class="flex items-center gap-2.5 text-sm font-semibold text-ink"
                    >
                      <span
                        class="h-1.5 w-1.5 rounded-full bg-lime"
                        aria-hidden="true"
                      ></span>
                      {l.navLabel}
                    </li>
                  ) : (
                    <li class="pl-4">
                      <a
                        href={`/${l.slug}`}
                        class="text-sm text-gray-500 transition-colors hover:text-ink"
                      >
                        {l.navLabel}
                      </a>
                    </li>
                  ),
                )}
              </ul>
            </nav>
          )}

          {tocItems.length > 0 && (
            <nav aria-label={`On this page: ${page.title}`}>
              <p
                class="font-mono text-[0.625rem] uppercase tracking-[0.16em] text-gray-400"
              >
                On this page
              </p>
              <ul class="mt-3.5 flex flex-col">
                {tocItems.map((t) => (
                  <li>
                    <a
                      href={`#${t.id}`}
                      data-toc-link
                      class:list={[
                        "toc-link group flex gap-2.5 py-1.5 text-sm leading-snug text-gray-500 transition-colors hover:text-ink",
                        t.level === 3 && "pl-[2.375rem] text-[0.8125rem]",
                      ]}
                    >
                      {t.num && (
                        <span
                          class="toc-num font-mono text-[0.6875rem] tabular-nums leading-5 text-gray-300 transition-colors"
                        >
                          {t.num}
                        </span>
                      )}
                      <span>{t.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
        </div>
      </aside>

      <!-- article -->
      <article class="legal-body min-w-0 max-w-[42rem]" set:html={html} />
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* Gentle, calm entrance for the header (guarded for reduced motion). */
  @media (prefers-reduced-motion: no-preference) {
    .lg-fade {
      animation: lgFade 0.5s cubic-bezier(0.2, 0.6, 0.2, 1) both;
    }
  }
  @keyframes lgFade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Active states for the TOC scrollspy. */
  .toc-link.is-active {
    color: var(--color-ink);
    font-weight: 500;
  }
  .toc-link.is-active .toc-num {
    color: var(--color-lime-dark);
  }

  /* --- Article prose ------------------------------------------------------
     Portable Text is injected via set:html, so target it with :global() under
     the scoped .legal-body wrapper. Tuned to the brand tokens; quiet + editorial. */
  .legal-body {
    counter-reset: legal-section;
    color: var(--color-gray-600);
    font-size: 1rem;
    line-height: 1.75;
  }
  .legal-body :global(p) {
    margin: 1.05rem 0;
  }
  /* Lead paragraph — the intro reads a touch larger + darker. */
  .legal-body :global(> p:first-child) {
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--color-gray-700);
    margin-bottom: 1.75rem;
  }
  .legal-body :global(h2) {
    counter-increment: legal-section;
    scroll-margin-top: 6rem;
    margin-top: 3.25rem;
    color: var(--color-ink);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  /* Numbered mono kicker above each section — mirrors the sidebar outline. */
  .legal-body :global(h2)::before {
    content: counter(legal-section, decimal-leading-zero);
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--color-lime-dark);
  }
  .legal-body :global(h3) {
    scroll-margin-top: 6rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--color-ink);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .legal-body :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-gray-300);
    text-underline-offset: 3px;
    transition:
      color 0.15s ease,
      text-decoration-color 0.15s ease;
  }
  .legal-body :global(a:hover) {
    color: var(--color-lime-dark);
    text-decoration-color: var(--color-lime);
  }
  .legal-body :global(strong) {
    color: var(--color-gray-800);
    font-weight: 600;
  }
  .legal-body :global(ul),
  .legal-body :global(ol) {
    margin: 1.1rem 0;
    padding-left: 1.4rem;
  }
  .legal-body :global(ul) {
    list-style: none;
  }
  .legal-body :global(ol) {
    list-style: decimal;
  }
  .legal-body :global(li) {
    margin: 0.4rem 0;
    padding-left: 0.4rem;
  }
  /* Custom bullet: a small lime square, in keeping with the header eyebrow. */
  .legal-body :global(ul > li) {
    position: relative;
  }
  .legal-body :global(ul > li)::before {
    content: "";
    position: absolute;
    left: -0.9rem;
    top: 0.7em;
    height: 0.375rem;
    width: 0.375rem;
    background: var(--color-lime);
  }
  .legal-body :global(ol > li)::marker {
    color: var(--color-lime-dark);
    font-variant-numeric: tabular-nums;
  }
  .legal-body :global(blockquote) {
    margin: 1.4rem 0;
    border-left: 2px solid var(--color-lime);
    padding: 0.15rem 0 0.15rem 1.1rem;
    color: var(--color-gray-500);
    font-style: normal;
  }
</style>

<!-- Scrollspy + smooth anchor scroll (like stripe.com/guides). No JS = plain
     anchor links that still work; base content is never hidden. -->
<script is:inline>
  (() => {
    const links = Array.from(document.querySelectorAll("[data-toc-link]"));
    if (!links.length) return;
    const linkById = new Map(
      links.map((l) => [decodeURIComponent(l.hash.slice(1)), l]),
    );
    const headings = Array.from(
      document.querySelectorAll(".legal-body h2, .legal-body h3"),
    ).filter((h) => h.id && linkById.has(h.id));
    if (!headings.length) return;

    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let current = null;
    const setActive = (id) => {
      if (id === current) return;
      current = id;
      links.forEach((l) => l.classList.remove("is-active"));
      linkById.get(id)?.classList.add("is-active");
    };

    // Smooth-scroll on click; keep the URL hash in sync.
    linkById.forEach((link, id) => {
      link.addEventListener("click", (e) => {
        const el = document.getElementById(id);
        if (!el) return;
        e.preventDefault();
        history.replaceState(null, "", `#${id}`);
        el.scrollIntoView({
          behavior: reduce ? "auto" : "smooth",
          block: "start",
        });
        setActive(id);
      });
    });

    // Highlight the section you're currently reading: the last heading whose top
    // has scrolled past a line near the top of the viewport. Deterministic (no
    // observer-band lag), rAF-throttled.
    const LINE = 120; // px from the top of the viewport
    let ticking = false;
    const update = () => {
      ticking = false;
      let activeId = headings[0].id;
      for (const h of headings) {
        if (h.getBoundingClientRect().top - LINE <= 0) activeId = h.id;
        else break;
      }
      setActive(activeId);
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  })();
</script>
