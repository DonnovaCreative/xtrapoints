---
// Legal pages (Terms & Conditions, Privacy Policy, …). One dynamic root route,
// one document per page in Sanity (doc type `legalPage`). The rendered body lives
// in LegalPageView.astro (shared with the draft preview route); this file just
// supplies published data. Adding a legal doc in the Studio makes its page +
// cross-links appear with no code change (the slug IS the URL).
import LegalPageView from "@/components/LegalPageView.astro";
import { getLegalPages } from "@/data/legalSource";

export async function getStaticPaths() {
  const pages = await getLegalPages();
  return pages.map((page) => ({
    params: { legal: page.slug },
    props: { page, all: pages },
  }));
}

const { page, all } = Astro.props;
---

<LegalPageView page={page} all={all} />
