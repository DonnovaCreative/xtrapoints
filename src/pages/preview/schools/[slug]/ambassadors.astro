---
// On-demand DRAFT preview of a co-branded school AMBASSADOR page. Same component
// as the live route, from the school's unpublished draft. Secret-gated + noindex.
export const prerender = false;

import SchoolAmbassadors from "@/components/school/SchoolAmbassadors.astro";
import { getSchoolDraft, getSiteSettings } from "@/data/schoolsSource";
import { previewUnauthorized } from "@/lib/previewGuard";

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

const denied = previewUnauthorized(Astro.url);
if (denied) return denied;

const { slug } = Astro.params;

let school;
let settings;
try {
  school = slug ? await getSchoolDraft(slug) : undefined;
  settings = await getSiteSettings();
} catch (err) {
  const msg =
    err instanceof Error ? `${err.name}: ${err.message}\n\n${err.stack ?? ""}` : String(err);
  return new Response(`Preview data error:\n\n${msg}`, {
    status: 500,
    headers: { "content-type": "text/plain; charset=utf-8" },
  });
}

if (!school) {
  return new Response(
    `No school found for “${slug}”. It may not exist yet, or has no draft or published version.`,
    { status: 404, headers: { "content-type": "text/plain; charset=utf-8" } },
  );
}
---

<SchoolAmbassadors school={school} settings={settings} />
