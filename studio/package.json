{
  "name": "xtrapoint-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Sanity Studio for XtraPoint co-branded school pages",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "import": "sanity exec scripts/import.ts --with-user-token",
    "seed:college": "sanity exec scripts/seed-college.ts --with-user-token",
    "seed:legal": "sanity exec scripts/seed-legal.ts --with-user-token",
    "seed:legal-extra": "sanity exec scripts/seed-legal-extra.ts --with-user-token",
    "seed:support": "sanity exec scripts/seed-support.ts --with-user-token",
    "backfill:ambassador-defaults": "sanity exec scripts/backfill-ambassador-defaults.ts --with-user-token"
  },
  "dependencies": {
    "@sanity/icons": "^3.8.0",
    "@sanity/vision": "^3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sanity": "^3",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
