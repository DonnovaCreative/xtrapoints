# Studio env for the "Open preview" button (previewAction.ts).
# SANITY_STUDIO_* vars are read when the Studio is built/deployed (npx sanity deploy)
# and bundled into the client, so keep the secret low-sensitivity (see note in
# previewAction.ts). Copy this file to studio/.env and fill in.

# Where the site's draft-preview route is deployed.
SANITY_STUDIO_PREVIEW_ORIGIN=https://www.xtrapoint.com

# Must MATCH the site's PREVIEW_SECRET (root .env + Vercel Production/Preview).
SANITY_STUDIO_PREVIEW_SECRET=

# "Promote to production" tool (promoteTool.tsx) — the Vercel Deploy Hook for
# the production (main branch) deploy. Vercel → Project → Settings → Git →
# Deploy Hooks. Publishing no longer auto-deploys to production; this button
# is how content goes live there.
SANITY_STUDIO_PRODUCTION_DEPLOY_HOOK_URL=
